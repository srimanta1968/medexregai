{
  "requiresAuth": true,
  "taskId": "6e5368a1-c26e-4c0f-915c-9b9224348a99",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "DELETE /api/se-comparisons/:comparisonId - delete an SE comparison",
  "description": "An SE comparison table is built from subject and predicate summary with citations (F5.2 AC2). Deletes a comparison table. 204. Needs projects:write; audited as se_comparison.deleted.",
  "endpoint": "/api/se-comparisons/:comparisonId",
  "method": "DELETE",
  "expectedStatus": 204,
  "priority": 206,
  "coversCriterion": [
    "34cf8e34-0e14-4774-9861-0a3050a15c73#AC2",
    "6e5368a1-c26e-4c0f-915c-9b9224348a99#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "pathParams": {
    "comparisonId": "{{var:pr_delete_comparison_id}}"
  },
  "timeoutMs": 30000,
  "errorCases": [
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Comparison not found",
      "when": "comparison is not in the caller's firm"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:write (reviewers and viewers)"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Deletes the spare comparison",
      "fixture": "tests/setup_scripts/49_predicates.py",
      "headers": {
        "Authorization": "Bearer {{var:pr_token}}"
      },
      "pathParams": {
        "comparisonId": "{{var:pr_delete_comparison_id}}"
      },
      "expectedStatus": 204
    },
    {
      "name": "404 - another firm's comparison",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "comparisonId": "{{var:pr_comparison_id}}"
      },
      "fixture": "tests/setup_scripts/49_predicates.py"
    },
    {
      "name": "403 - a reviewer cannot delete",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "pathParams": {
        "comparisonId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "comparisonId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ]
}
