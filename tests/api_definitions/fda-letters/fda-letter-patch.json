{
  "requiresAuth": true,
  "taskId": "37cb380d-5c35-4456-96a5-eb8650b72bfc",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/fda-letters/:letterId - update a letter",
  "description": "An FDA AI or hold letter can be logged with deficiencies linked to sections and due dates (F5.1 AC1). Changes a letter's status (open, responded, closed), responded date (set to today when marked responded without one), FDA reference, received date, due date (never before the letter date) or notes. Needs projects:write; audited as fda_letter.updated.",
  "endpoint": "/api/fda-letters/:letterId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 193,
  "coversCriterion": [
    "af7a916c-8bab-433f-9dab-3ae83f278b73#AC1",
    "37cb380d-5c35-4456-96a5-eb8650b72bfc#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "issuedOn must be a date (YYYY-MM-DD)",
      "when": "a field is missing, malformed or out of range, or a link is to another project"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:write (reviewers and viewers)"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Letter not found",
      "when": "letter is not in the caller's firm"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Records the received date and a note",
      "fixture": "tests/setup_scripts/46_fda_letters.py",
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "pathParams": {
        "letterId": "{{var:fl_letter_id}}"
      },
      "payload": {
        "receivedOn": "{{static:2026-06-03}}",
        "notes": "{{static:Forwarded by the client on 3 June.}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "receivedOn": "2026-06-03",
          "status": "open"
        }
      }
    },
    {
      "name": "400 - due date before the letter date",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "dueOn": "{{static:2026-01-01}}"
      },
      "pathParams": {
        "letterId": "{{var:fl_letter_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "400 - nothing to change",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {},
      "pathParams": {
        "letterId": "{{var:fl_letter_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "400 - unknown status",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "status": "{{static:approved}}"
      },
      "pathParams": {
        "letterId": "{{var:fl_letter_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "404 - another firm's letter",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "notes": "{{static:x}}"
      },
      "pathParams": {
        "letterId": "{{var:fl_letter_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "403 - a reviewer cannot change FDA letters",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "pathParams": {
        "letterId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "payload": {
        "notes": "{{static:x}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "notes": "{{static:x}}"
      },
      "pathParams": {
        "letterId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ],
  "pathParams": {
    "letterId": "{{var:fl_letter_id}}"
  },
  "payload": {
    "notes": "{{static:Checked.}}"
  }
}
