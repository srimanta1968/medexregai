{
  "requiresAuth": true,
  "taskId": "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/problems/:problemId - one problem with both sources side by side",
  "description": "A contradiction between two sources is shown side by side (AC1): each source with file, version, whether it is current, revision, page/sheet/slide, the stated value and the exact quote; a gap with its section and the passage that triggered it; and the consultant’s decision and note once made. Needs projects:read.",
  "endpoint": "/api/problems/:problemId",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 101,
  "coversCriterion": [
    "7a98c57b-d633-406d-9803-39075fa4aee8#AC1",
    "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/problems/check"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Problem not found",
      "when": "no such problem, or another firm’s"
    }
  ],
  "testCases": [
    {
      "name": "Consultant opens a problem",
      "pathParams": {
        "problemId": "{{cache:problems.check.response.data.open.0.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "problemId": "{{cache:problems.check.response.data.open.0.id}}"
      }
    },
    {
      "name": "404 - unknown problem",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "problemId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "problemId": "{{static:not-a-uuid}}"
      }
    }
  ]
}
