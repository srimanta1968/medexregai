{
  "requiresAuth": true,
  "taskId": "37cb380d-5c35-4456-96a5-eb8650b72bfc",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/fda-deficiencies/:deficiencyId - update a deficiency",
  "description": "An FDA AI or hold letter can be logged with deficiencies linked to sections and due dates (F5.1 AC1). Changes a deficiency's summary, eSTAR section (or none), owner (consultant or client), status (open, requested, drafting, ready, answered) or due date. Needs projects:write; audited as fda_deficiency.updated.",
  "endpoint": "/api/fda-deficiencies/:deficiencyId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 196,
  "coversCriterion": [
    "af7a916c-8bab-433f-9dab-3ae83f278b73#AC1",
    "37cb380d-5c35-4456-96a5-eb8650b72bfc#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "issuedOn must be a date (YYYY-MM-DD)",
      "when": "a field is missing, malformed or out of range, or a link is to another project"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:write (reviewers and viewers)"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Deficiency not found",
      "when": "deficiency is not in the caller's firm"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Moves deficiency 1 to drafting, owned by the consultant, due 15 October",
      "fixture": "tests/setup_scripts/46_fda_letters.py",
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "payload": {
        "status": "{{static:drafting}}",
        "owner": "{{static:consultant}}",
        "dueOn": "{{static:2026-10-15}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "drafting",
          "owner": "consultant",
          "dueOn": "2026-10-15",
          "sectionId": "sterility"
        }
      }
    },
    {
      "name": "400 - unknown status",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "status": "{{static:done}}"
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "400 - not an eSTAR section",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "sectionId": "{{static:no_such_section}}"
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "404 - another firm's deficiency",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "status": "{{static:ready}}"
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "403 - a reviewer cannot change FDA letters",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "pathParams": {
        "deficiencyId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "payload": {
        "status": "{{static:ready}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "status": "{{static:ready}}"
      },
      "pathParams": {
        "deficiencyId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ],
  "pathParams": {
    "deficiencyId": "{{var:fl_deficiency_id}}"
  },
  "payload": {
    "status": "{{static:ready}}"
  },
  "fieldEnums": {
    "owner": [
      "consultant",
      "client"
    ],
    "status": [
      "open",
      "requested",
      "drafting",
      "ready",
      "answered"
    ]
  }
}
