{
  "requiresAuth": true,
  "taskId": "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/settings/ai-providers/:providerId - rename or choose routes",
  "description": "Renames a provider or sets the AI routes it serves (one firm provider per route; others lose the route). Enabling any route needs a passed connection test (409 PROVIDER_NOT_TESTED); routes marked as needing evaluation (draft) also need the evaluation gate (409 EVALUATION_REQUIRED); the database enforces both. Covers: a firm-supplied model must pass a connection test and the evaluation gate before it is used for drafting.",
  "endpoint": "/api/settings/ai-providers/:providerId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 83,
  "coversCriterion": [
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC7",
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC4",
    "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/settings/ai-providers"
  ],
  "fieldEnums": {
    "enabledRoutes": [
      "triage",
      "classify",
      "extract",
      "contradiction",
      "draft",
      "request_wording"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Missing permission firm:manage",
      "when": "caller is a reviewer"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "AI provider not found",
      "when": "no provider with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "routes must be some of ...",
      "when": "unknown route or empty body"
    },
    {
      "status": 409,
      "code": "PROVIDER_NOT_TESTED",
      "message": "Run a successful connection test before enabling this provider for any AI route.",
      "when": "enabling routes before a passed test"
    },
    {
      "status": 409,
      "code": "EVALUATION_REQUIRED",
      "message": "This model must pass the evaluation gate before it can be used for draft.",
      "when": "enabling draft on a tested provider that has not passed the evaluation gate",
      "reproducible": false,
      "reason": "Needs a provider that passed a real connection test; an automated run has no working third-party model. Verified by hand 2026-11-10 with a test status set in the database."
    }
  ],
  "testCases": [
    {
      "name": "Owner renames a provider",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:company}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "409 - routes before a passed connection test",
      "testType": "negative",
      "coversErrorCase": "409|PROVIDER_NOT_TESTED",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {
        "enabledRoutes": [
          "classify"
        ]
      },
      "expectedStatus": 409,
      "expectedError": {
        "code": "PROVIDER_NOT_TESTED"
      }
    },
    {
      "name": "400 - unknown route",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {
        "enabledRoutes": [
          "everything"
        ]
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:company}}"
      }
    },
    {
      "name": "403 - reviewer cannot manage AI settings",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:company}}"
      }
    },
    {
      "name": "404 - unknown provider",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "providerId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {
        "name": "{{dynamic:company}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    }
  ]
}
