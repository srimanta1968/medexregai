# MedexRegAI API - environment template
#
# Do not copy this by hand: run   scripts/setup-env.sh
# It creates server/.env from this file, generates every blank secret below, and never
# overwrites a value you have already set. server/.env is gitignored; never commit it.
#
# Variables marked REQUIRED have no fallback in code: the API refuses to start without them.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=MedexRegAI

# ============================================
# DATABASE (PostgreSQL 16+ with pgvector)
# ============================================
# Local dev uses the shared ProjexLight Postgres container on 5432 (database medexregai_db).
DB_HOST=localhost                     # REQUIRED
DB_PORT=5432
DB_NAME=medexregai_db                 # REQUIRED
DB_USER=postgres                      # REQUIRED
DB_PASSWORD=                          # REQUIRED - set to your local Postgres password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# SECURITY (generated by scripts/setup-env.sh)
# ============================================
JWT_SECRET=                           # REQUIRED - at least 32 chars, generated
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# AES-256 key for stored OAuth tokens and firm-supplied model API keys: 64 hex chars.
ENCRYPTION_KEY=                       # REQUIRED - generated
BCRYPT_ROUNDS=12

# ============================================
# EMAIL AND LINKS
# ============================================
# Public URL of the web app (password-reset links point here).
APP_BASE_URL=http://localhost:5173
# "log" writes emails to the server log (development only; refused in production).
MAIL_TRANSPORT=log
MAIL_FROM=MedexRegAI <no-reply@localhost>

# ============================================
# CORS
# ============================================
# Comma-separated extra origins. localhost:3000/5173 and projexlight.com are always allowed.
CORS_ORIGIN=

# ============================================
# QUEUE AND CACHE (Redis)
# ============================================
REDIS_URL=redis://localhost:6379      # REQUIRED

# ============================================
# OBJECT STORAGE (S3-compatible; SeaweedFS locally via docker compose, AWS S3 in production)
# ============================================
S3_ENDPOINT=http://localhost:9000     # REQUIRED
S3_REGION=us-east-1
S3_BUCKET=medexregai-dev              # REQUIRED
S3_ACCESS_KEY_ID=medexregai           # REQUIRED - copied to .env for docker compose
S3_SECRET_ACCESS_KEY=                 # REQUIRED - generated, copied to .env for docker compose
S3_FORCE_PATH_STYLE=true

# ============================================
# AI MODELS (default: our own self-hosted models)
# ============================================
# AI_PROVIDER: ollama (dev/test default) | openai_compatible (vLLM in prod) | anthropic (opt-in)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434   # REQUIRED - Ollama default port
AI_GENERATION_MODEL=qwen2.5:7b-instruct   # REQUIRED - pulled by scripts/pull-models.sh
AI_EMBEDDING_MODEL=bge-m3                 # REQUIRED - pulled by scripts/pull-models.sh
AI_REQUEST_TIMEOUT_MS=120000

# ============================================
# LOGGING, RATE LIMITS, BODY SIZE
# ============================================
LOG_LEVEL=info
LOG_FORMAT=dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Uploads go straight to object storage via presigned URLs, so JSON bodies stay small.
BODY_PARSER_LIMIT=1mb
