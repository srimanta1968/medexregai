  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/settings/ai-providers/:providerId/test - connection test",
  "description": "Checks the provider is reachable (URL re-checked by the SSRF guard), accepts the key and serves the configured model, using the provider's model list (no generation tokens spent). Always 200 with passed true/false and a typed error; a failed test clears any routes the provider served. The test fixture uses https://example.com/v1, which is not an AI API, so the run checks the failure path (AI_BAD_RESPONSE); the success path is covered by the adapter checks against fake servers. Covers: a firm-supplied model must pass a connection test before it is used.",
  "endpoint": "/api/settings/ai-providers/:providerId/test",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 82,
  "coversCriterion": [
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC7",
    "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/settings/ai-providers"
  ],
  "responseFields": [
    "passed",
    "latencyMs",
    "error",
    "provider"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Missing permission firm:manage",
      "when": "caller is a reviewer"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "AI provider not found",
      "when": "no provider with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "providerId must be a valid id",
      "when": "providerId is not a uuid"
    }
  ],
  "testCases": [
    {
      "name": "Owner runs the connection test (reports failure clearly)",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "passed": false
        }
      },
      "capturesResponse": true,
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "403 - reviewer cannot manage AI settings",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "404 - unknown provider",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "providerId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "payload": {}
    },
    {
      "name": "400 - provider id not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "providerId": "{{static:not-a-uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "payload": {}
    }
  ],
  "captureResponse": {
    "aiProviders.test.response.data.passed": "data.passed"
  }
}
