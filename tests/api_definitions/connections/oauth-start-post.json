{
  "name": "POST /api/connections/oauth/:provider/start - begin a read-only connection",
  "description": "Starts connecting a provider read-only via OAuth (AC1, AC2): returns the provider sign-in URL with a one-time state (10 minutes, single use) and a PKCE challenge, requesting read scopes only. returnPath must be an app path. Needs projects:write.",
  "endpoint": "/api/connections/oauth/:provider/start",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 142,
  "taskId": "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "717d5baf-5788-4106-9669-e387af1830b0#AC1",
    "717d5baf-5788-4106-9669-e387af1830b0#AC2",
    "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf#AC1",
    "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "captureResponse": {
    "connections.start.response.data.authorizeUrl": "data.authorizeUrl",
    "connections.start.response.data.expiresAt": "data.expiresAt"
  },
  "fieldEnums": {
    "provider": [
      "dropbox",
      "box",
      "onedrive",
      "google_drive"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "returnPath must be an app path",
      "when": "returnPath is not an /app path"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Unknown folder provider",
      "when": "provider is not dropbox, box, onedrive or google_drive"
    },
    {
      "status": 503,
      "code": "CONNECTION_PROVIDER_NOT_CONFIGURED",
      "message": "is not set up on this server yet",
      "when": "the provider's OAuth app (client id and secret) is not configured on this server"
    }
  ],
  "testCases": [
    {
      "name": "Consultant starts connecting Dropbox",
      "pathParams": {
        "provider": "{{static:dropbox}}"
      },
      "payload": {
        "returnPath": "{{static:/app/connections}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "provider": "{{static:dropbox}}"
      },
      "payload": {}
    },
    {
      "name": "403 - reviewer cannot connect",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "provider": "{{static:dropbox}}"
      },
      "payload": {}
    },
    {
      "name": "400 - returnPath outside the app",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "provider": "{{static:dropbox}}"
      },
      "payload": {
        "returnPath": "{{static:https://example.com/elsewhere}}"
      }
    },
    {
      "name": "404 - unknown provider",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "provider": "{{static:ftp}}"
      },
      "payload": {}
    }
  ]
}
