{
  "requiresAuth": true,
  "taskId": "b3fcbe8e-822c-4e8a-9efd-507e81697eec",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/summary-tables - summary of testing with mismatches",
  "description": "Summary tables are drafted from test reports and open in Excel with a mismatch count (F3.6 AC2). One row per test report filed under a testing section: standards with editions, acceptance criteria and the result the report states, read from the report's text. Each row is compared with the project's latest drafts: EDITION (a draft names the standard with another edition), RESULT (a draft citing the report states the opposite result), OUTDATED (a draft cites an older version of the report). Returns rows, reportCount and mismatchCount. Needs projects:read.",
  "endpoint": "/api/projects/:projectId/summary-tables",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 142,
  "coversCriterion": [
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC2",
    "b3fcbe8e-822c-4e8a-9efd-507e81697eec#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "projectId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project in the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant reads the summary of testing",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "reportCount": 1,
          "mismatchCount": 1
        }
      }
    },
    {
      "name": "404 - another firm's project",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "400 - not a uuid",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
