# MedexRegAI API - environment template
#
# Do not copy this by hand: run   scripts/setup-env.sh
# It creates server/.env from this file, generates every blank secret below, and never
# overwrites a value you have already set. server/.env is gitignored; never commit it.
#
# Variables marked REQUIRED have no fallback in code: the API refuses to start without them.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=MedexRegAI

# ============================================
# DATABASE (PostgreSQL 16+ with pgvector)
# ============================================
# Local dev uses the shared ProjexLight Postgres container on 5432 (database medexregai_db).
DB_HOST=localhost                     # REQUIRED
DB_PORT=5432
DB_NAME=medexregai_db                 # REQUIRED
DB_USER=postgres                      # REQUIRED
DB_PASSWORD=                          # REQUIRED - set to your local Postgres password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# SECURITY (generated by scripts/setup-env.sh)
# ============================================
JWT_SECRET=                           # REQUIRED - at least 32 chars, generated
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# AES-256 key for stored OAuth tokens and firm-supplied model API keys: 64 hex chars.
ENCRYPTION_KEY=                       # REQUIRED - generated
BCRYPT_ROUNDS=12

# ============================================
# EMAIL AND LINKS
# ============================================
# Public URL of the web app (password-reset links point here).
APP_BASE_URL=http://localhost:5173
# "log" writes emails to the server log (development only; refused in production).
MAIL_TRANSPORT=log
MAIL_FROM=MedexRegAI <no-reply@localhost>

# ============================================
# SIGN-IN WITH GOOGLE / MICROSOFT (optional)
# ============================================
# A provider appears on the sign-in page only when BOTH its id and secret are set.
# Redirect URI to register with the provider: <APP_BASE_URL>/api/auth/sso/<google|microsoft>/callback
#   e.g. http://localhost:5173/api/auth/sso/google/callback
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Microsoft: Entra ID > App registrations. Add the optional ID-token claim "xms_edov"
# so first-time sign-in can match an existing account by verified email.
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations

# ============================================
# CORS
# ============================================
# Comma-separated extra origins. localhost:3000/5173 and projexlight.com are always allowed.
CORS_ORIGIN=

# ============================================
# QUEUE AND CACHE (Redis)
# ============================================
REDIS_URL=redis://localhost:6379      # REQUIRED

# ============================================
# OBJECT STORAGE (S3-compatible; SeaweedFS locally via docker compose, AWS S3 in production)
# ============================================
S3_ENDPOINT=http://localhost:9000     # REQUIRED
S3_REGION=us-east-1
S3_BUCKET=medexregai-dev              # REQUIRED
S3_ACCESS_KEY_ID=medexregai           # REQUIRED - copied to .env for docker compose
S3_SECRET_ACCESS_KEY=                 # REQUIRED - generated, copied to .env for docker compose
S3_FORCE_PATH_STYLE=true

# ============================================
# AI MODELS (default: our own self-hosted models)
# ============================================
# AI_PROVIDER: ollama (dev/test default) | openai_compatible (vLLM in prod) | anthropic (opt-in)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434   # REQUIRED - Ollama default port
AI_GENERATION_MODEL=qwen2.5:7b-instruct   # REQUIRED - pulled by scripts/pull-models.sh
AI_EMBEDDING_MODEL=bge-m3                 # REQUIRED - pulled by scripts/pull-models.sh
AI_REQUEST_TIMEOUT_MS=120000
# AI_API_KEY: bearer key for openai_compatible (vLLM --api-key) or anthropic; leave blank for Ollama.
AI_API_KEY=
# AI_ROUTE_MODELS: per-route model for this environment, e.g. draft=qwen2.5:14b-instruct (routes: triage,
# classify, extract, contradiction, draft, request_wording). Unset routes use AI_GENERATION_MODEL.
AI_ROUTE_MODELS=
# AI_EMBEDDING_BASE_URL: Ollama used for embeddings when AI_PROVIDER=anthropic (Claude has no embeddings).
AI_EMBEDDING_BASE_URL=http://localhost:11434
# Optional reranker for search (TEI-compatible POST /rerank, e.g. bge-reranker-v2-m3). Empty: results are fused but not reranked.
AI_RERANK_URL=
AI_RERANK_MODEL=bge-reranker-v2-m3
# OPS_ALERT_EMAIL: operator mailbox for alerts such as a project's AI usage passing 2x its estimate.
OPS_ALERT_EMAIL=

# ============================================
# LOGGING, RATE LIMITS, BODY SIZE
# ============================================
LOG_LEVEL=info
LOG_FORMAT=dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Uploads go straight to object storage via presigned URLs, so JSON bodies stay small.
BODY_PARSER_LIMIT=1mb

# ============================================
# PUBLIC WEBSITE
# ============================================
# Proxy hops to trust for the client IP: "loopback" locally (Vite proxy), 2 behind CloudFront + ALB. Never "true".
TRUST_PROXY=loopback
# Pilot requests accepted per IP per hour (raise in test environments).
PILOT_REQUESTS_PER_IP_PER_HOUR=5
# Optional: who is emailed when a pilot request arrives.
PILOT_NOTIFY_EMAIL=
# Free device checks (public product-code pages, F6.1) per IP per hour (raise in test environments).
DEVICE_CHECKS_PER_IP_PER_HOUR=10

# ============================================
# FEATURE FLAGS (menu by phase, UI 2.0 §3)
# ============================================
# 1-5: show every menu item of this phase and earlier.
APP_PHASE=1
# Comma-separated item keys to enable early / hide (unknown keys stop startup),
# e.g. FEATURE_FLAGS_ON=time  FEATURE_FLAGS_OFF=trust-pack
FEATURE_FLAGS_ON=
FEATURE_FLAGS_OFF=

# ============================================
# FDA DATA SERVICE (ADR-017)
# ============================================
# FDA data lives in services/fda-data (its own database). openFDA settings moved
# to services/fda-data/.env. Create this app's key inside fda-data with
#   npm run clients -- create medexregai-app fda:read fda:track
FDA_SERVICE_URL=http://localhost:4100
FDA_SERVICE_KEY=
FDA_SERVICE_TIMEOUT_MS=5000

# ============================================
# DOCUMENT PARSING SIDECAR (services/docproc, F7.2)
# ============================================
# Runs in the no-egress sandbox (docker compose up docproc docproc-gateway); the
# worker posts file bytes to it. scripts/setup-env.sh generates DOCPROC_API_KEY and
# copies it into the root .env, where the docproc container reads the same value.
DOCPROC_URL=http://localhost:4200
DOCPROC_TIMEOUT_MS=150000
DOCPROC_API_KEY=
# In AWS the worker logs the ingest queue depth for docproc autoscaling.
DOCPROC_QUEUE_METRIC=false

# ============================================
# DEVELOPMENT FILE UPLOAD (F7.2)
# ============================================
# POST /api/projects/:id/files accepts a file through the API so ingest can be
# tried before presigned uploads (F8.2) and folder connectors (E2) exist.
# Refused when NODE_ENV=production. With DOCPROC_API_KEY set, uploads are parsed
# right away; otherwise the worker parses them.
DEV_UPLOADS=false
DEV_UPLOAD_MAX_BYTES=52428800

# ============================================
# CLIENT UPLOAD LINKS AND MALWARE SCAN (F2.4)
# ============================================
# Clients upload missing evidence through an expiring no-login link (/u/<token>).
CLIENT_UPLOAD_MAX_BYTES=104857600   # per file (100 MB)
CLIENT_UPLOAD_MAX_FILES=50          # per link
# clamd for malware scanning (INSTREAM). Required in production (uploads are
# refused, not stored unscanned, when it is missing or down). In development,
# leave CLAMAV_HOST empty to store uploads as not_scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
MALWARE_SCAN_REQUIRED=false

# ============================================
# TRUST PACK (F2.5)
# ============================================
# Shown in the validation pack, data-handling pack and deletion certificates.
RELEASE_VERSION=development build
HOSTING_REGION=us-east-1
# Must equal the database backup retention set in Terraform (production: 35 days):
# deleted project rows remain in encrypted backups until they expire.
BACKUP_RETENTION_DAYS=35

# ============================================
# PROJECT FORWARDING ADDRESSES (F2.1)
# ============================================
# Each project can have its own address <project>.<token>@INBOUND_EMAIL_DOMAIN.
# Leave the domain empty to turn the feature off. A mail relay (in AWS: an SES
# receipt rule that stores the message in S3 and a small forwarder) posts each raw
# message to POST /api/inbound/email with header X-Inbound-Key: <relay key> and,
# when it knows them, X-Envelope-To: <recipients>. The relay should reject mail that
# fails DMARC; the API also refuses a message whose Authentication-Results say so.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_RELAY_KEY=        # secret: at least 32 random characters
INBOUND_EMAIL_MAX_BYTES=41943040  # 40 MB, the SES receiving limit

# F2.1 read-only folder connections. A provider appears only when both values are set.
# Register this redirect URI with each provider: <APP_BASE_URL>/api/connections/oauth/<provider>/callback
#   provider = dropbox | box | onedrive | google_drive
# Dropbox: Scoped access, Full Dropbox; scopes account_info.read, files.metadata.read, files.content.read only.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Box: OAuth 2.0 (User Authentication) app; scope "Read all files and folders" only.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Microsoft Entra app registration: delegated Files.Read.All, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations (work/school accounts), common, or a tenant id.
MICROSOFT_FILES_TENANT=organizations
# Google Cloud OAuth client (Web application); scope drive.readonly.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
