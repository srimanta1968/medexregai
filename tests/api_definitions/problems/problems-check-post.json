{
  "requiresAuth": true,
  "taskId": "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/projects/:projectId/problems/check - re-check a project for gaps and contradictions",
  "description": "Missing required evidence is flagged as a gap (AC3) and a contradiction between two sources is detected (AC1): re-runs the rule-based checks now and returns the counts and the open problems. With one uploaded file the five sections every 510(k) needs show as gaps. Action endpoint: 200. Needs projects:write.",
  "endpoint": "/api/projects/:projectId/problems/check",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 99,
  "coversCriterion": [
    "7a98c57b-d633-406d-9803-39075fa4aee8#AC1",
    "7a98c57b-d633-406d-9803-39075fa4aee8#AC3",
    "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d#AC1",
    "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/files"
  ],
  "captureResponse": {
    "problems.check.response.data.open.0.id": "data.open.0.id"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    }
  ],
  "testCases": [
    {
      "name": "Consultant re-checks the project",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {},
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "403 - reviewer cannot re-check",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      },
      "payload": {}
    }
  ]
}
