{
  "requiresAuth": true,
  "taskId": "f95359c7-abcc-4c4c-b0e1-d26dc8c96067",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "coversCriterion": [
    "717d5baf-5788-4106-9669-e387af1830b0#AC5",
    "f95359c7-abcc-4c4c-b0e1-d26dc8c96067#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/inbound-email"
  ],
  "name": "DELETE /api/projects/:projectId/inbound-email - turn the forwarding address off",
  "description": "Projects:write. The address stops accepting mail at once (the relay gets 404 RECIPIENT_UNKNOWN). Messages already received stay listed. Audited (inbound_address.revoked). Covers: a per-project forwarding email address accepts attachments into the project within 2 minutes.",
  "endpoint": "/api/projects/:projectId/inbound-email",
  "method": "DELETE",
  "expectedStatus": 200,
  "priority": 125,
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Your role (reviewer) does not allow this action",
      "when": "the member cannot edit projects (e.g. a reviewer)"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "unknown project (an address already off answers 404 \"This project has no forwarding address\")"
    }
  ],
  "testCases": [
    {
      "name": "403 - a reviewer cannot turn it off",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "Owner turns the address off",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "address": null
        }
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    }
  ]
}
