{
  "requiresAuth": true,
  "taskId": "91e7f58c-a5fa-49b6-a2f4-fc8bb115e36d",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/project-sections/:sectionId/draft - queue a cited draft of the section",
  "description": "A section draft is generated with a citation on every statement (F3.2 AC1; uncited statements are removed and listed, AC2). Queues a generated draft (202; status queued, the worker drafts it: evidence from the section's files and project search, the draft model, then the citation gate in every-statement mode). Moves a not-started section to drafting. Needs projects:write. The route takes no body; an empty JSON object is sent. A second request while one is queued or generating answers 409 DRAFT_IN_PROGRESS; it depends on timing, so it is verified by hand (two POSTs in a row), not by a testCase.",
  "endpoint": "/api/project-sections/:sectionId/draft",
  "method": "POST",
  "expectedStatus": 202,
  "priority": 106,
  "coversCriterion": [
    "4bb0c6e6-956d-41c0-a6ee-01496b331169#AC1",
    "4bb0c6e6-956d-41c0-a6ee-01496b331169#AC2",
    "91e7f58c-a5fa-49b6-a2f4-fc8bb115e36d#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "GET /api/projects/:projectId/sections"
  ],
  "captureResponse": {
    "drafts.request.response.data.id": "data.id"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "sectionId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Section not found",
      "when": "no such section, or another firm’s"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (e.g. reviewer)"
    }
  ],
  "testCases": [
    {
      "name": "Consultant asks for a draft of the section",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "expectedStatus": 202,
      "expectedResponse": {
        "success": true,
        "data": {
          "versionNo": 1,
          "origin": "generated"
        }
      },
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {}
    },
    {
      "name": "403 - reviewer role cannot draft",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {}
    },
    {
      "name": "404 - unknown section",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "sectionId": "{{dynamic:uuid}}"
      },
      "payload": {}
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "sectionId": "{{static:not-a-uuid}}"
      },
      "payload": {}
    }
  ],
  "fieldEnums": {
    "status": [
      "queued",
      "generating",
      "ready",
      "failed"
    ],
    "origin": [
      "generated",
      "imported"
    ]
  }
}
