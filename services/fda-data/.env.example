# =============================================================================
# fda-data service (ADR-017). Copy to .env. Separate from server/.env: this
# service has its own database and never sees customer data or app secrets.
# =============================================================================
PORT=4100

# Primary FDA database (writes). Its own instance in production; in local dev it
# can be a separate database on the dev Postgres, e.g. .../fda_db.
FDA_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/fda_db   # REQUIRED
# Or give the parts instead of a URL (production: from the RDS secret):
# FDA_DB_HOST= FDA_DB_PORT=5432 FDA_DB_USER= FDA_DB_PASSWORD= FDA_DB_NAME=fda_db
FDA_DB_SSL=false
# Optional read replica for /v1 reads (URL, or FDA_READ_DB_HOST with the same credentials); blank = primary.
FDA_READ_DATABASE_URL=
FDA_READ_DB_HOST=
FDA_DB_POOL_MAX=10

# openFDA (public). A free API key raises the daily request allowance.
OPENFDA_API_KEY=
# openFDA allows 240 requests per minute; stay below it.
OPENFDA_MAX_PER_MINUTE=200
OPENFDA_INITIAL_LOOKBACK_DAYS=90
# Product codes to track for MAUDE counts besides those the app pushes.
FDA_EVENT_PRODUCT_CODES=
FDA_SYNC_HOUR_UTC=3

# 510(k) summary PDFs (F1.2): fetched politely from accessdata.fda.gov for the product
# codes the app tracks, once each, into the FDA document bucket (never client files).
FDA_DOCS_ENABLED=true
# S3 bucket (AWS: the task role supplies credentials). Blank = local folder FDA_DOCS_DIR.
FDA_DOCS_BUCKET=
FDA_DOCS_REGION=us-east-1
# Only for an S3-compatible store such as the local SeaweedFS:
FDA_DOCS_S3_ENDPOINT=
FDA_DOCS_S3_FORCE_PATH_STYLE=false
FDA_DOCS_S3_ACCESS_KEY_ID=
FDA_DOCS_S3_SECRET_ACCESS_KEY=
FDA_DOCS_DIR=data/fda-docs
# At least this many ms between requests to the FDA site; PDFs per worker pass.
FDA_DOCS_MIN_INTERVAL_MS=5000
FDA_DOCS_BATCH=20
# Summaries parsed, chunked and embedded per worker pass.
FDA_DOCS_INDEX_BATCH=5

# Sandboxed parser (services/docproc). Same key as the docproc container.
DOCPROC_URL=http://localhost:4200
DOCPROC_API_KEY=
DOCPROC_TIMEOUT_MS=150000

# Embedding model for the public summary index: bge-m3, 1024 dimensions (same as the app).
# ollama (local) or openai_compatible (vLLM / TEI in production).
FDA_EMBEDDING_PROVIDER=ollama
FDA_EMBEDDING_URL=http://localhost:11434
FDA_EMBEDDING_MODEL=bge-m3
FDA_EMBEDDING_API_KEY=
