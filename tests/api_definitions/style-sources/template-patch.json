{
  "requiresAuth": true,
  "taskId": "b3fcbe8e-822c-4e8a-9efd-507e81697eec",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/templates/:templateId - edit a template or turn it off",
  "description": "Drafts can follow the firm's own templates and past wording, used only for that firm (F3.6 AC1); turning firm style sources off removes them from drafting within 1 hour and past wording never crosses tenants (F3.6 AC5). Body { name?, body?, enabled? } (at least one). enabled=false keeps the template out of every draft started afterwards. Needs projects:write.",
  "endpoint": "/api/templates/:templateId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 135,
  "coversCriterion": [
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC1",
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC5",
    "b3fcbe8e-822c-4e8a-9efd-507e81697eec#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Nothing to update",
      "when": "empty body, bad field, or path id not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Template not found",
      "when": "no such template in the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "Firm renames its template",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "pathParams": {
        "templateId": "{{var:style_template_id}}"
      },
      "payload": {
        "name": "Studio sterility outline"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "name": "Studio sterility outline"
        }
      }
    },
    {
      "name": "404 - another firm's template",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "templateId": "{{var:style_template_id}}"
      },
      "payload": {
        "enabled": false
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "400 - nothing to update",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "templateId": "{{var:style_template_id}}"
      },
      "payload": {},
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "templateId": "{{var:style_template_id}}"
      },
      "payload": {
        "name": "x"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
