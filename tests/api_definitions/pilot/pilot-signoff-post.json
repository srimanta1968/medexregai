{
  "requiresAuth": true,
  "taskId": "ba95f351-522e-4fa9-8728-1a4c4d7b603f",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/projects/:projectId/pilot-report/sign-off - the firm's RA lead signs the report",
  "description": "Hours by activity export to CSV and the report has a sign-off for the firm's RA lead (F4.2 AC3). Body { signerTitle (1-200), note? (at most 1000) }: records the signer (name from their profile), title, note and the SHA-256 of the report numbers as they stand, and returns the report with its sign-offs; a sign-off whose SHA-256 no longer matches is shown as made on earlier figures. Needs drafts:review (owner, admin, reviewer); audited as pilot.report_signed.",
  "endpoint": "/api/projects/:projectId/pilot-report/sign-off",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 175,
  "coversCriterion": [
    "8810a366-70b1-4b42-a9ca-ab8411e7ce9c#AC3",
    "ba95f351-522e-4fa9-8728-1a4c4d7b603f#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "projectId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "signerTitle is required",
      "when": "signerTitle missing, too long, or extra fields"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project in the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "RA lead signs the pilot report",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/43_pilot_report.py",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "payload": {
        "signerTitle": "RA lead",
        "note": "Hours checked against our timesheets."
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "wholeProject": {
            "actualHours": 20
          }
        }
      }
    },
    {
      "name": "400 - signerTitle missing",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/43_pilot_report.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "payload": {},
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "404 - another firm's project",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "payload": {
        "signerTitle": "RA lead"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "payload": {
        "signerTitle": "RA lead"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
