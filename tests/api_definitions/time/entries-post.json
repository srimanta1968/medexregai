{
  "requiresAuth": true,
  "taskId": "e39bf66f-0168-47cb-ad67-4413518095e9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/time/entries - add time afterwards",
  "description": "A consultant can start and stop a timer per task category in one click (F4.1 AC1); time is logged against the A3 activity codes: chase, find, version, map, trace, read, reconcile, tabulate, write, forms, attachments, client review (AC3). Body { activityCode, projectId?, startedAt, endedAt, note? }: an entry typed in afterwards (source manual). endedAt after startedAt, at most 36 hours, not in the future. Needs projects:read.",
  "endpoint": "/api/time/entries",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 155,
  "coversCriterion": [
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC1",
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC3",
    "e39bf66f-0168-47cb-ad67-4413518095e9#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "endedAt must be after startedAt",
      "when": "unknown activity, end not after start, longer than 36 hours, in the future, or bad fields"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "projectId is not a project of the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant logs an hour of reading",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "payload": {
        "activityCode": "{{static:read}}",
        "startedAt": "{{var:time_manual_start}}",
        "endedAt": "{{var:time_manual_end}}",
        "note": "EO report"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "activityCode": "read",
          "source": "manual",
          "running": false
        }
      }
    },
    {
      "name": "400 - end before start",
      "headers": {
        "Authorization": "Bearer {{var:time_idle_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {
        "activityCode": "{{static:read}}",
        "startedAt": "{{var:time_manual_end}}",
        "endedAt": "{{var:time_manual_start}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - unknown activity code",
      "headers": {
        "Authorization": "Bearer {{var:time_idle_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {
        "activityCode": "{{static:billing}}",
        "startedAt": "{{var:time_manual_start}}",
        "endedAt": "{{var:time_manual_end}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "404 - another firm's project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "headers": {
        "Authorization": "Bearer {{var:time_idle_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "payload": {
        "activityCode": "{{static:read}}",
        "projectId": "{{var:time_stopper_project_id}}",
        "startedAt": "{{var:time_manual_start}}",
        "endedAt": "{{var:time_manual_end}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "payload": {
        "activityCode": "{{static:read}}",
        "startedAt": "{{var:time_manual_start}}",
        "endedAt": "{{var:time_manual_end}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ],
  "captureResponse": {
    "timeEntries.create.response.data.id": "data.id"
  }
}
