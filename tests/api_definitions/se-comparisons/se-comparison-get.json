{
  "requiresAuth": true,
  "taskId": "6e5368a1-c26e-4c0f-915c-9b9224348a99",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/se-comparisons/:comparisonId - one SE comparison",
  "description": "An SE comparison table is built from subject and predicate summary with citations (F5.2 AC2). One comparison with its rows (attribute, subject and predicate cells each with text and citations, comparison, note, edited). Rows: product code, device class and regulation number from FDA records and the subject device's record, compared deterministically (same or different; FDA's numeric class 2 reads as II); then indications for use, technology, materials, sterilization, shelf life, biocompatibility and performance testing, each with the best passage of the client's own files cited [C:<version>#<location>] and of the predicate's public 510(k) summary cited [R:<K-number>#<passage>], always 'review': MedexRegAI never decides substantial equivalence. Needs projects:read.",
  "endpoint": "/api/se-comparisons/:comparisonId",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 203,
  "coversCriterion": [
    "34cf8e34-0e14-4774-9861-0a3050a15c73#AC2",
    "6e5368a1-c26e-4c0f-915c-9b9224348a99#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "pathParams": {
    "comparisonId": "{{var:pr_comparison_id}}"
  },
  "timeoutMs": 30000,
  "errorCases": [
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Comparison not found",
      "when": "comparison is not in the caller's firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "comparisonId must be a valid id",
      "when": "malformed id"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:read",
      "reproducible": false,
      "notReproducibleReason": "Every firm role has projects:read."
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "The comparison with the summary-indexed predicate",
      "fixture": "tests/setup_scripts/49_predicates.py",
      "headers": {
        "Authorization": "Bearer {{var:pr_token}}"
      },
      "pathParams": {
        "comparisonId": "{{var:pr_comparison_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "predicateKNumber": "{{var:pr_k_number}}",
          "counts": {
            "rows": 10
          }
        }
      }
    },
    {
      "name": "404 - another firm's comparison",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "comparisonId": "{{var:pr_comparison_id}}"
      },
      "fixture": "tests/setup_scripts/49_predicates.py"
    },
    {
      "name": "400 - comparisonId is not an id",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:pr_token}}"
      },
      "pathParams": {
        "comparisonId": "{{static:not-an-id}}"
      },
      "fixture": "tests/setup_scripts/49_predicates.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "comparisonId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ]
}
