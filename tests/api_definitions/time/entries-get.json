  },
  "name": "GET /api/time/entries - own time entries",
  "description": "A consultant can start and stop a timer per task category in one click (F4.1 AC1); time is logged against the A3 activity codes: chase, find, version, map, trace, read, reconcile, tabulate, write, forms, attachments, client review (AC3). The caller's entries, newest first, keyset-paginated (?limit 1-50, ?cursor), optionally ?from/?to (ISO date-times, on start) and ?projectId. Each: activity, project, start, end, seconds, source (timer | manual), note, editedAt. Needs projects:read.",
  "endpoint": "/api/time/entries",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 154,
  "coversCriterion": [
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC1",
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC3",
    "e39bf66f-0168-47cb-ad67-4413518095e9#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "from must be an ISO 8601 date-time",
      "when": "bad from/to/projectId/limit/cursor"
    }
  ],
  "testCases": [
    {
      "name": "Consultant lists their week's entries",
      "headers": {
        "Authorization": "Bearer {{var:time_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "queryParams": {
        "from": "{{var:time_week_start}}T00:00:00Z",
        "projectId": "{{var:time_project_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - from is not a date-time",
      "headers": {
        "Authorization": "Bearer {{var:time_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "queryParams": {
        "from": "last week"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
