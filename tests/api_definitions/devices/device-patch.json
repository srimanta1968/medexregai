{
  "name": "PATCH /api/devices/:deviceId - update a device",
  "description": "Updates name, modelNames, udiDi, productCode or deviceClass. Sending null clears an optional field (e.g. \"udiDi\": null); omitting a key leaves it unchanged. The device id never changes. Needs projects:write.",
  "endpoint": "/api/devices/:deviceId",
  "method": "PATCH",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 55,
  "taskId": "a9fee73a-bb05-4de6-b28d-10dd328567a9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "aace117c-ee0f-45ab-8e35-83da03f3824f#AC2",
    "a9fee73a-bb05-4de6-b28d-10dd328567a9#AC1",
    "aace117c-ee0f-45ab-8e35-83da03f3824f#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Device not found",
      "when": "device does not exist or belongs to another firm (same answer, so other firms' ids are not disclosed)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Nothing to update",
      "when": "empty body or malformed field"
    },
    {
      "status": 409,
      "code": "DUPLICATE_UDI_DI",
      "message": "already has this UDI-DI",
      "when": "UDI-DI used by another device in the firm",
      "reproducible": false,
      "notReproducibleReason": "Needs two devices sharing one fixed UDI-DI in a run; verified by hand."
    }
  ],
  "testCases": [
    {
      "name": "Owner sets the UDI-DI and model names",
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "coversCriterion": [
        "aace117c-ee0f-45ab-8e35-83da03f3824f#AC3"
      ],
      "payload": {
        "udiDi": "{{dynamic:numeric14}}",
        "modelNames": [
          "{{static:IP-300}}"
        ]
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "deviceClass": "II"
      }
    },
    {
      "name": "403 - reviewer cannot write",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "deviceClass": "II"
      }
    },
    {
      "name": "404 - unknown device",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "deviceId": "{{dynamic:uuid}}"
      },
      "payload": {
        "deviceClass": "II"
      }
    },
    {
      "name": "400 - nothing to update",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {}
    }
  ]
}
