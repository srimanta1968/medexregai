{
  "requiresAuth": true,
  "taskId": "944991b0-597f-4388-b6b4-b514ba034cb8",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/introductions/settings - the firm's introduction opt-in",
  "description": "The firm's opt-in (default off), FDA medical-specialty codes and pathways it takes, and its profile. Needs firm:manage. Routing (F6.2 AC1): a company's request is offered only to firms that opted in and whose FDA medical specialties and pathways match (a firm listing none takes any); up to 3 firms, longest since their last offer first. Fixture 53_introductions.py proves it across three firms (opted in and matching, matching but not opted in, opted in but another specialty).",
  "endpoint": "/api/introductions/settings",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 231,
  "coversCriterion": [
    "a44bb850-46f5-44bd-920e-205427202979#AC1",
    "944991b0-597f-4388-b6b4-b514ba034cb8#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks firm:manage (editors, reviewers, viewers)",
      "reproducible": false,
      "notReproducibleReason": "Fixture firms have only an owner."
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Opted-out fixture firm",
      "fixture": "tests/setup_scripts/53_introductions.py",
      "headers": {
        "Authorization": "Bearer {{var:in_token}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "optedIn": false
        }
      }
    },
    {
      "name": "New firm defaults to not opted in",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "optedIn": false,
          "updatedAt": null
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {}
    }
  ]
}
