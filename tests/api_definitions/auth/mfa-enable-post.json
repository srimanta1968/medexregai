{
  "requiresAuth": true,
  "taskId": "3d97cbcb-19e4-4e2a-abb5-5db12738acd0",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "name": "POST /api/auth/mfa/enable - confirm setup with a code",
  "description": "F4.4 pre-test hardening (SOC 2 CC6-04), toward 'An external penetration test is passed before the first paid live project'. Confirms setup with a current 6-digit code from the app and returns ten one-time recovery codes, shown once and stored as SHA-256 hashes. The success path needs a live TOTP code, which a static test case cannot hold; fixture 45_auth_security.py proves it by enabling MFA for two users with a computed code and asserting ten recovery codes. Audited as auth.mfa_enabled.",
  "endpoint": "/api/auth/mfa/enable",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 188,
  "coversCriterion": [
    "0f388230-24e7-4721-bf25-346b65312095#AC1",
    "3d97cbcb-19e4-4e2a-abb5-5db12738acd0#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "INVALID_MFA_CODE",
      "message": "The code is not correct or has already been used",
      "when": "wrong code, a code already used, or a used recovery code"
    },
    {
      "status": 409,
      "code": "MFA_ALREADY_ENABLED",
      "message": "Two-step sign-in is already on",
      "when": "MFA is already on"
    },
    {
      "status": 409,
      "code": "MFA_NOT_SET_UP",
      "message": "Start setup first",
      "when": "setup was never started"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "code is required",
      "when": "code missing, too short or too long"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "401 - wrong code after setup",
      "testType": "negative",
      "coversErrorCase": "401|INVALID_MFA_CODE",
      "expectedStatus": 401,
      "expectedError": {
        "code": "INVALID_MFA_CODE"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_pending_token}}"
      },
      "payload": {
        "code": "{{static:000000}}"
      },
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "409 - already on",
      "testType": "negative",
      "coversErrorCase": "409|MFA_ALREADY_ENABLED",
      "expectedStatus": 409,
      "expectedError": {
        "code": "MFA_ALREADY_ENABLED"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_user_token}}"
      },
      "payload": {
        "code": "{{static:000000}}"
      },
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "409 - setup never started",
      "testType": "negative",
      "coversErrorCase": "409|MFA_NOT_SET_UP",
      "expectedStatus": 409,
      "expectedError": {
        "code": "MFA_NOT_SET_UP"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_plain_token}}"
      },
      "payload": {
        "code": "{{static:000000}}"
      },
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "400 - code missing",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_user_token}}"
      },
      "payload": {},
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "code": "{{static:000000}}"
      }
    }
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "payload": {
    "code": "{{static:000000}}"
  }
}
