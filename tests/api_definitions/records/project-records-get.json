{
  "requiresAuth": true,
  "taskId": "34dbc9e8-df24-49a0-b055-e1a2e0bc69c9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/records - records generated for the project",
  "description": "The dated records generated for the eQMS (F3.4 AC3, AC5), newest first: kind, format, SHA-256 of the exact bytes, size, eSTAR template, who and when, so a filed record can be matched to what the tool produced. Needs projects:read.",
  "endpoint": "/api/projects/:projectId/records",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 117,
  "coversCriterion": [
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC3",
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC5",
    "34dbc9e8-df24-49a0-b055-e1a2e0bc69c9#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "GET /api/projects/:projectId/records/:kind"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    }
  ],
  "testCases": [
    {
      "name": "Consultant lists the records made so far",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      }
    }
  ]
}
