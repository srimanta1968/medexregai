  "name": "GET /api/api-keys - the firm's API keys",
  "description": "The firm's API keys, newest first, cursor-paged: name, 10-character prefix, scopes, creator, created, expires, last used, revoked, status (active, expired, revoked). Never the secret. Needs firm:manage. Keys are 'mrk_' + 32 random bytes; only the SHA-256 is stored and the secret is shown once. A key works ONLY on /api/v1 routes, each needing one scope (portfolio:read, fda:read); missing, unknown, revoked or expired keys get 401 INVALID_API_KEY, a key without the scope 403 INSUFFICIENT_SCOPE, and the app's own routes refuse keys. Fixture 54_api_keys.py proves the scoping across four keys.",
  "endpoint": "/api/api-keys",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 240,
  "coversCriterion": [
    "ecedaab8-630c-4976-bf61-48e6ddac19ee#AC2",
    "49c3da4a-e317-4b13-bb85-1605493ff677#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "queryParams": {},
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "limit must be 1-50",
      "when": "limit outside 1-50 or an unknown parameter"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks firm:manage",
      "reproducible": false,
      "notReproducibleReason": "Fixture firms have only an owner."
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "not signed in"
    }
  ],
  "testCases": [
    {
      "name": "Keys of the fixture firm",
      "fixture": "tests/setup_scripts/54_api_keys.py",
      "headers": {
        "Authorization": "Bearer {{var:ak_token}}"
      },
      "queryParams": {},
      "expectedStatus": 200
    },
    {
      "name": "A new firm has none",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "queryParams": {},
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "nextCursor": null
        }
      }
    },
    {
      "name": "400 - limit above 50",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
