{
  "requiresAuth": true,
  "taskId": "b3fcbe8e-822c-4e8a-9efd-507e81697eec",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PUT /api/style-sources - turn firm style sources on or off",
  "description": "Drafts can follow the firm's own templates and past wording, used only for that firm (F3.6 AC1); turning firm style sources off removes them from drafting within 1 hour and past wording never crosses tenants (F3.6 AC5). Body { enabled: boolean }. Drafting reads the switch when it claims a draft, so a draft started after it is turned off uses no template or past wording (a draft already being written finishes within its 15-minute claim). Needs firm:manage; audited as style_sources.updated.",
  "endpoint": "/api/style-sources",
  "method": "PUT",
  "expectedStatus": 200,
  "priority": 131,
  "coversCriterion": [
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC1",
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC5",
    "b3fcbe8e-822c-4e8a-9efd-507e81697eec#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "enabled is required",
      "when": "enabled missing or not a boolean, or extra fields"
    }
  ],
  "testCases": [
    {
      "name": "Owner turns style sources off",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "payload": {
        "enabled": false
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "enabled": false
        }
      }
    },
    {
      "name": "400 - enabled is not a boolean",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {
        "enabled": "yes"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - enabled missing",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {},
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "payload": {
        "enabled": false
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
