{
  "requiresAuth": true,
  "taskId": "2cb97497-4c3b-44db-a4be-265564f1b16e",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/sections - the review board",
  "description": "Sections show status: not started, drafting, in review, approved (AC1): every eSTAR section that takes evidence for the submission type, in FDA order, with status, assigned reviewer (AC2), who approved it, how many files are filed there and open problems; plus the firm members who can be assigned as reviewers. Needs projects:read.",
  "endpoint": "/api/projects/:projectId/sections",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 103,
  "coversCriterion": [
    "989d6eb8-075c-49df-8c36-8974220a2936#AC1",
    "989d6eb8-075c-49df-8c36-8974220a2936#AC2",
    "2cb97497-4c3b-44db-a4be-265564f1b16e#AC1",
    "2cb97497-4c3b-44db-a4be-265564f1b16e#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "captureResponse": {
    "sections.board.response.data.sections.0.id": "data.sections.0.id",
    "sections.board.response.data.reviewers.0.id": "data.reviewers.0.id"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    }
  ],
  "testCases": [
    {
      "name": "Consultant opens the review board",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      }
    }
  ],
  "fieldEnums": {
    "status": [
      "not_started",
      "drafting",
      "in_review",
      "approved"
    ]
  }
}
