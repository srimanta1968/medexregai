{
  "requiresAuth": true,
  "taskId": "b3fcbe8e-822c-4e8a-9efd-507e81697eec",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/templates - add a section template",
  "description": "Drafts can follow the firm's own templates and past wording, used only for that firm (F3.6 AC1); turning firm style sources off removes them from drafting within 1 hour and past wording never crosses tenants (F3.6 AC5). Body { sectionId (eSTAR section id), name (1-200), body (1-20000), enabled? }. One template per section per firm (409 TEMPLATE_EXISTS). Drafting gives it to the model as an untagged outline: it shapes order and wording, never facts. Needs projects:write.",
  "endpoint": "/api/templates",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 133,
  "coversCriterion": [
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC1",
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC5",
    "b3fcbe8e-822c-4e8a-9efd-507e81697eec#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "sectionId is not an eSTAR section",
      "when": "unknown section, missing name or body, or extra fields"
    },
    {
      "status": 409,
      "code": "TEMPLATE_EXISTS",
      "message": "This firm already has a template for that section",
      "when": "the firm already has a template for the section"
    }
  ],
  "testCases": [
    {
      "name": "Firm adds a Labeling template",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "payload": {
        "sectionId": "labeling",
        "name": "Studio labeling outline",
        "body": "Labels first, then the instructions for use, then warnings and precautions."
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "sectionId": "labeling",
          "name": "Studio labeling outline",
          "enabled": true
        }
      }
    },
    {
      "name": "409 - the firm already has a Sterility template",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "409|TEMPLATE_EXISTS",
      "payload": {
        "sectionId": "sterility",
        "name": "Second outline",
        "body": "Another outline."
      },
      "expectedStatus": 409,
      "expectedError": {
        "code": "TEMPLATE_EXISTS"
      }
    },
    {
      "name": "400 - not an eSTAR section",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {
        "sectionId": "not_a_section",
        "name": "x",
        "body": "x"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - body missing",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "payload": {
        "sectionId": "labeling",
        "name": "x"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "payload": {
        "sectionId": "labeling",
        "name": "x",
        "body": "x"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
