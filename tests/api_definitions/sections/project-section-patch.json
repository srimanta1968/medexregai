{
  "requiresAuth": true,
  "taskId": "2cb97497-4c3b-44db-a4be-265564f1b16e",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/project-sections/:sectionId - move a section along or assign its reviewer",
  "description": "Sections show status: not started, drafting, in review, approved (AC1) and a reviewer can be assigned to a section (AC2). Allowed: not_started->drafting->in_review->approved, in_review->drafting (sent back), approved->drafting (reopened), drafting->not_started. Moving along and assigning need projects:write; approving or sending back need drafts:review. The reviewer must be a firm member whose role can review. Every change is kept in the history. Cases run in order through the workflow.",
  "endpoint": "/api/project-sections/:sectionId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 104,
  "coversCriterion": [
    "989d6eb8-075c-49df-8c36-8974220a2936#AC1",
    "989d6eb8-075c-49df-8c36-8974220a2936#AC2",
    "2cb97497-4c3b-44db-a4be-265564f1b16e#AC1",
    "2cb97497-4c3b-44db-a4be-265564f1b16e#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "GET /api/projects/:projectId/sections"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write to move a section along or assign, or drafts:review to approve or send back"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Nothing to change",
      "when": "empty body, unknown status, or a reviewer who cannot review"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Section not found",
      "when": "no such section, or another firm’s"
    },
    {
      "status": 409,
      "code": "SECTION_STATUS_INVALID",
      "message": "cannot go to",
      "when": "the status change skips a step (e.g. drafting -> approved)"
    }
  ],
  "testCases": [
    {
      "name": "Owner starts drafting the section",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:drafting}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "drafting"
        }
      }
    },
    {
      "name": "409 - drafting cannot jump to approved",
      "testType": "negative",
      "coversErrorCase": "409|SECTION_STATUS_INVALID",
      "expectedStatus": 409,
      "expectedError": {
        "code": "SECTION_STATUS_INVALID"
      },
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:approved}}"
      }
    },
    {
      "name": "403 - reviewer role cannot send for review",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:in_review}}"
      }
    },
    {
      "name": "Owner sends the section for review",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:in_review}}",
        "note": "{{static:Ready for review}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "in_review"
        }
      }
    },
    {
      "name": "Owner assigns the reviewer",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "reviewerId": "{{cache:sections.board.response.data.reviewers.0.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "Reviewer approves the section",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:approved}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "approved"
        }
      }
    },
    {
      "name": "400 - nothing to change",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "status": "{{static:drafting}}"
      }
    },
    {
      "name": "404 - unknown section",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "sectionId": "{{dynamic:uuid}}"
      },
      "payload": {
        "status": "{{static:drafting}}"
      }
    }
  ],
  "fieldEnums": {
    "status": [
      "not_started",
      "drafting",
      "in_review",
      "approved"
    ]
  }
}
