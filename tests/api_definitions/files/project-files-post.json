{
  "requiresAuth": true,
  "taskId": "2fd4277b-fd52-48f0-970f-3dc09c43653e",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/projects/:projectId/files - add a file or a new version (development upload)",
  "description": "Development-only intake (DEV_UPLOADS=true; refused in production, where files arrive by presigned upload, F8.2, or a connected folder, E2). Body is the raw file with X-File-Name, or JSON {fileName, contentBase64, mimeType}. The same name in a project adds a new file_version and keeps the old ones; identical bytes add nothing (200, unchanged=true). The version is queued for parsing in the docproc sandbox. Covers: re-uploading a file creates a new file_version and keeps the old one; files are parsed with page, sheet, cell or slide locations.",
  "endpoint": "/api/projects/:projectId/files",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 90,
  "coversCriterion": [
    "25aed8eb-2a0c-411e-947c-1963ebf27356#AC2",
    "25aed8eb-2a0c-411e-947c-1963ebf27356#AC1",
    "2fd4277b-fd52-48f0-970f-3dc09c43653e#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices/:deviceId/projects"
  ],
  "captureResponse": {
    "files.upload.response.data.id": "data.id",
    "files.upload.response.data.latest.id": "data.latest.id"
  },
  "fieldEnums": {
    "source": [
      "upload",
      "linked",
      "request"
    ],
    "parseStatus": [
      "queued",
      "parsing",
      "parsed",
      "failed",
      "unsupported"
    ],
    "phiStatus": [
      "not_scanned",
      "clean",
      "flagged",
      "redacted",
      "accepted"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Your role (reviewer) does not allow this action",
      "when": "caller lacks projects:write"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "contentBase64 must be base64",
      "when": "missing name, empty or malformed content"
    },
    {
      "status": 403,
      "code": "UPLOADS_DISABLED",
      "message": "Uploading through the API is turned off here",
      "when": "DEV_UPLOADS is not true",
      "reproducible": false,
      "reason": "The test environment runs with DEV_UPLOADS=true; verified by hand with it off."
    },
    {
      "status": 413,
      "code": "FILE_TOO_LARGE",
      "message": "Files up to 50 MB can be uploaded",
      "when": "body above DEV_UPLOAD_MAX_BYTES",
      "reproducible": false,
      "reason": "Needs a body above 50 MB; enforced from Content-Length before the body is read."
    }
  ],
  "testCases": [
    {
      "name": "Owner adds a complaint log to the project",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "fileName": "complaints.csv",
        "contentBase64": "Q2FzZSxOb3RlCkNSLTIyMSwiUGF0aWVudDogSmFuZSBEb2UsIERPQjogMDMvMTQvMTk2MSIKQ1ItMjIyLERldmljZSByZXR1cm5lZCBmb3IgYW5hbHlzaXMK",
        "mimeType": "text/csv"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - content is not base64",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "fileName": "x.csv",
        "contentBase64": "not base64!"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {
        "fileName": "x.csv",
        "contentBase64": "YSxi"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "fileName": "x.csv",
        "contentBase64": "YSxi"
      }
    },
    {
      "name": "403 - reviewer cannot change project files",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "fileName": "x.csv",
        "contentBase64": "YSxi"
      }
    }
  ]
}
