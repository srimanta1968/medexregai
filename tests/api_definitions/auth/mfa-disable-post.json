{
  "requiresAuth": true,
  "taskId": "3d97cbcb-19e4-4e2a-abb5-5db12738acd0",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "name": "POST /api/auth/mfa/disable - turn two-step sign-in off",
  "description": "F4.4 pre-test hardening (SOC 2 CC6-04), toward 'An external penetration test is passed before the first paid live project'. Turns two-step sign-in off; needs a current authenticator code or an unused recovery code, so a stolen session alone cannot remove it. Wrong codes count toward the 429 limit. Audited as auth.mfa_disabled.",
  "endpoint": "/api/auth/mfa/disable",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 189,
  "coversCriterion": [
    "0f388230-24e7-4721-bf25-346b65312095#AC1",
    "3d97cbcb-19e4-4e2a-abb5-5db12738acd0#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "INVALID_MFA_CODE",
      "message": "The code is not correct or has already been used",
      "when": "wrong code, a code already used, or a used recovery code"
    },
    {
      "status": 409,
      "code": "MFA_NOT_SET_UP",
      "message": "Two-step sign-in is not on",
      "when": "MFA is off"
    },
    {
      "status": 429,
      "code": "RATE_LIMITED",
      "message": "Too many attempts. Try again in 15 minutes.",
      "when": "5 wrong codes for this user (or the IP limit) in 15 minutes"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "A recovery code turns MFA off",
      "fixture": "tests/setup_scripts/45_auth_security.py",
      "headers": {
        "Authorization": "Bearer {{var:mfa_disable_token}}"
      },
      "payload": {
        "code": "{{var:mfa_disable_recovery_code}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "enabled": false
        }
      }
    },
    {
      "name": "401 - wrong code",
      "testType": "negative",
      "coversErrorCase": "401|INVALID_MFA_CODE",
      "expectedStatus": 401,
      "expectedError": {
        "code": "INVALID_MFA_CODE"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_user_token}}"
      },
      "payload": {
        "code": "{{static:000000}}"
      },
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "409 - MFA is not on",
      "testType": "negative",
      "coversErrorCase": "409|MFA_NOT_SET_UP",
      "expectedStatus": 409,
      "expectedError": {
        "code": "MFA_NOT_SET_UP"
      },
      "headers": {
        "Authorization": "Bearer {{var:mfa_plain_token}}"
      },
      "payload": {
        "code": "{{static:000000}}"
      },
      "fixture": "tests/setup_scripts/45_auth_security.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "code": "{{static:000000}}"
      }
    }
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "payload": {
    "code": "{{var:mfa_disable_recovery_code}}"
  }
}
