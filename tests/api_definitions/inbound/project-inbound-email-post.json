  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "coversCriterion": [
    "717d5baf-5788-4106-9669-e387af1830b0#AC5",
    "f95359c7-abcc-4c4c-b0e1-d26dc8c96067#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "name": "POST /api/projects/:projectId/inbound-email - turn on (or replace) the forwarding address",
  "description": "Projects:write. Issues <project-slug>.<10 random characters>@<INBOUND_EMAIL_DOMAIN> for the project. Called again, it replaces the address: the old one stops working at once and the allowed senders carry over. Audited (inbound_address.created). Covers: a per-project forwarding email address accepts attachments into the project within 2 minutes.",
  "endpoint": "/api/projects/:projectId/inbound-email",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 120,
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    },
    {
      "status": 409,
      "code": "INBOUND_EMAIL_NOT_CONFIGURED",
      "message": "Forwarding addresses are not set up on this server (INBOUND_EMAIL_DOMAIN is empty)",
      "when": "the server has no INBOUND_EMAIL_DOMAIN"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Your role (reviewer) does not allow this action",
      "when": "the member cannot edit projects (e.g. a reviewer)"
    }
  ],
  "testCases": [
    {
      "name": "Owner turns on the forwarding address",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {},
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "configured": true
        }
      },
      "capturesResponse": true,
      "coversCriterion": [
        "717d5baf-5788-4106-9669-e387af1830b0#AC5"
      ]
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {}
    },
    {
      "name": "403 - a reviewer cannot turn it on",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {}
    }
  ],
  "captureResponse": {
    "inbound.address.response.data.address.email": "data.address.email"
  }
}
