{
  "name": "GET /api/projects/:projectId/estar-coverage - coverage panel and getting-started checklist",
  "description": "The eSTAR coverage panel shows sections with no evidence (AC3): every section that takes evidence for this submission type with its file count and empty flag. A getting-started checklist guides the first submission (AC4): files added, files read, files sorted, unsure files confirmed, empty sections checked, each with done and a detail. Needs projects:read.",
  "endpoint": "/api/projects/:projectId/estar-coverage",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 95,
  "taskId": "0401ddb6-557e-4083-add7-b68a19dca5ab",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "ce498dad-6bbe-4344-9969-1d64da4484e5#AC3",
    "ce498dad-6bbe-4344-9969-1d64da4484e5#AC4",
    "0401ddb6-557e-4083-add7-b68a19dca5ab#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or it belongs to another firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant reads coverage and the checklist",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      }
    }
  ]
}
