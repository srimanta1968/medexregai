{
  "name": "POST /api/auth/password-reset/confirm - set a new password",
  "description": "Sets a new password using the token from the reset email; the token works once and expires after 60 minutes, and all of the user's sessions are signed out. The happy path needs the emailed token, which an automated run cannot read (MAIL_TRANSPORT=log writes it to the server log), so expect it to be marked manual after the first run; the negative cases run automatically. Covers: a user can reset a forgotten password (step 2).",
  "endpoint": "/api/auth/password-reset/confirm",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "priority": 6,
  "taskId": "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC3",
    "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9#AC2"
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "INVALID_RESET_TOKEN",
      "message": "Reset link is invalid, expired or already used",
      "when": "unknown, expired or used token"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "password must be at least 12 characters",
      "when": "newPassword too short"
    }
  ],
  "testCases": [
    {
      "name": "User sets a new password with the emailed token",
      "coversCriterion": [
        "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC3",
        "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9#AC2"
      ],
      "payload": {
        "token": "{{static:token-from-reset-email}}",
        "newPassword": "{{static:New-Correct-Horse-77}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - unknown reset token",
      "testType": "negative",
      "coversErrorCase": "400|INVALID_RESET_TOKEN",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_RESET_TOKEN"
      },
      "payload": {
        "token": "{{static:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}",
        "newPassword": "{{static:New-Correct-Horse-77}}"
      }
    },
    {
      "name": "400 - new password too short",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "payload": {
        "token": "{{static:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}",
        "newPassword": "{{static:short}}"
      }
    }
  ]
}
