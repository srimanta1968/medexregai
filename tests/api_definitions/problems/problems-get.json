{
  "requiresAuth": true,
  "taskId": "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/problems - gaps and contradictions of a project",
  "description": "The project’s problems still found by the latest check (AC1, AC3): contradictions between two sources and gaps in the evidence, each with severity and the reason for it, open first; counts of open contradictions and gaps. ?status=open|resolved|dismissed|all. Keyset-paginated. Needs projects:read.",
  "endpoint": "/api/projects/:projectId/problems",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 100,
  "coversCriterion": [
    "7a98c57b-d633-406d-9803-39075fa4aee8#AC1",
    "7a98c57b-d633-406d-9803-39075fa4aee8#AC3",
    "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d#AC1",
    "fe1cc93e-b5fb-48d7-a6ee-664a75e3778d#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/problems/check"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "status must be open, resolved, dismissed or all",
      "when": "bad status, limit, cursor or project id"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    }
  ],
  "testCases": [
    {
      "name": "Consultant lists open problems",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "Consultant lists every problem",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "status": "{{static:all}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "400 - unknown status",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "status": "{{static:closed}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      }
    }
  ],
  "fieldEnums": {
    "status": [
      "open",
      "resolved",
      "dismissed",
      "all"
    ],
    "kind": [
      "contradiction",
      "gap"
    ],
    "severity": [
      "high",
      "medium",
      "low"
    ]
  }
}
