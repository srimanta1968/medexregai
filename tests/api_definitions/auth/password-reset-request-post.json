{
  "name": "POST /api/auth/password-reset/request - email a reset link",
  "description": "Sends a single-use password-reset link (valid 60 minutes) to the email if an active account exists. Always answers 202 with the same message, so it cannot be used to discover accounts. Covers: a user can reset a forgotten password (step 1).",
  "endpoint": "/api/auth/password-reset/request",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 202,
  "priority": 5,
  "taskId": "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC3",
    "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "email must be a valid email address",
      "when": "email malformed or missing"
    }
  ],
  "testCases": [
    {
      "name": "Reset link requested",
      "coversCriterion": [
        "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC3",
        "bfeba90f-3255-44a6-82d4-d53b3b5ef5d9#AC2"
      ],
      "payload": {
        "email": "{{cache:auth.register.response.data.user.email}}"
      },
      "expectedStatus": 202,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - malformed email",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "payload": {
        "email": "{{static:nope}}"
      }
    }
  ]
}
