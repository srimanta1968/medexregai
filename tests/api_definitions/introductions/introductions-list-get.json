  "name": "GET /api/introductions - introductions offered to the firm",
  "description": "Introductions offered to the caller's firm, newest first, cursor-paged; status filter (offered, accepted, declined). Each shows the company's brief, pathway, FDA specialty and product code; the company's name and contact are null until the firm accepts. Needs firm:manage. Routing (F6.2 AC1): a company's request is offered only to firms that opted in and whose FDA medical specialties and pathways match (a firm listing none takes any); up to 3 firms, longest since their last offer first. Fixture 53_introductions.py proves it across three firms (opted in and matching, matching but not opted in, opted in but another specialty).",
  "endpoint": "/api/introductions",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 233,
  "coversCriterion": [
    "a44bb850-46f5-44bd-920e-205427202979#AC1",
    "944991b0-597f-4388-b6b4-b514ba034cb8#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "queryParams": {},
  "fieldEnums": {
    "status": [
      "offered",
      "accepted",
      "declined"
    ]
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "status must be offered, accepted or declined",
      "when": "bad status, limit outside 1-50, bad cursor or unknown parameter"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks firm:manage (editors, reviewers, viewers)",
      "reproducible": false,
      "notReproducibleReason": "Fixture firms have only an owner."
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
