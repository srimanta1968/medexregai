{
  "name": "POST /api/devices/:deviceId/projects - start a submission project",
  "description": "Creates a submission project for a device: name, submissionType (traditional|special|abbreviated, default traditional), optional targetDate (YYYY-MM-DD). The project inherits the device's client. Needs projects:write. Covers: a user can create submission records.",
  "endpoint": "/api/devices/:deviceId/projects",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "priority": 56,
  "taskId": "a9fee73a-bb05-4de6-b28d-10dd328567a9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "aace117c-ee0f-45ab-8e35-83da03f3824f#AC2",
    "a9fee73a-bb05-4de6-b28d-10dd328567a9#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "captureResponse": {
    "projects.create.response.data.id": "data.id",
    "projects.create.response.data.name": "data.name"
  },
  "fieldEnums": {
    "submissionType": [
      "traditional",
      "special",
      "abbreviated"
    ],
    "status": [
      "active",
      "submitted",
      "cleared",
      "archived"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Device not found",
      "when": "device does not exist or belongs to another firm (same answer, so other firms' ids are not disclosed)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Invalid enum value",
      "when": "submissionType not traditional|special|abbreviated, or bad targetDate"
    }
  ],
  "testCases": [
    {
      "name": "Owner starts a Special 510(k) project",
      "capturesResponse": true,
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}",
        "submissionType": "special",
        "targetDate": "{{dynamic:futuredate+90d}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "submissionType": "special",
          "status": "active"
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "403 - reviewer cannot write",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "404 - unknown device",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "deviceId": "{{dynamic:uuid}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "400 - unsupported submission type",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "deviceId": "{{cache:devices.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}",
        "submissionType": "{{static:pma}}"
      }
    }
  ]
}
