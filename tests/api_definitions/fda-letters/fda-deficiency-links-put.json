{
  "requiresAuth": true,
  "taskId": "37cb380d-5c35-4456-96a5-eb8650b72bfc",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PUT /api/fda-deficiencies/:deficiencyId/links - set what a deficiency affects",
  "description": "An FDA AI or hold letter can be logged with deficiencies linked to sections and due dates (F5.1 AC1). Replaces the client files and drafted statements a deficiency affects; every one must belong to the letter's project (400 otherwise). Needs projects:write; audited as fda_deficiency.linked.",
  "endpoint": "/api/fda-deficiencies/:deficiencyId/links",
  "method": "PUT",
  "expectedStatus": 200,
  "priority": 197,
  "coversCriterion": [
    "af7a916c-8bab-433f-9dab-3ae83f278b73#AC1",
    "37cb380d-5c35-4456-96a5-eb8650b72bfc#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "issuedOn must be a date (YYYY-MM-DD)",
      "when": "a field is missing, malformed or out of range, or a link is to another project"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:write (reviewers and viewers)"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Deficiency not found",
      "when": "deficiency is not in the caller's firm"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Links the EO residuals report",
      "fixture": "tests/setup_scripts/46_fda_letters.py",
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "payload": {
        "fileIds": [
          "{{var:fl_file_id}}"
        ],
        "statementIds": []
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - a file from another project",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "fileIds": [
          "{{var:fl_other_file_id}}"
        ],
        "statementIds": []
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "400 - statementIds missing",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "payload": {
        "fileIds": []
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "404 - another firm's deficiency",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "fileIds": [],
        "statementIds": []
      },
      "pathParams": {
        "deficiencyId": "{{var:fl_deficiency_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "fileIds": [],
        "statementIds": []
      },
      "pathParams": {
        "deficiencyId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ],
  "pathParams": {
    "deficiencyId": "{{var:fl_deficiency_id}}"
  },
  "payload": {
    "fileIds": [],
    "statementIds": []
  }
}
