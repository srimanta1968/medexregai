{
  "requiresAuth": true,
  "taskId": "e39bf66f-0168-47cb-ad67-4413518095e9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "DELETE /api/time/entries/:entryId - delete an entry",
  "description": "A consultant can start and stop a timer per task category in one click (F4.1 AC1); time is logged against the A3 activity codes: chase, find, version, map, trace, read, reconcile, tabulate, write, forms, attachments, client review (AC3). Deletes one of the caller's entries (204); anyone else's is 404. Needs projects:read.",
  "endpoint": "/api/time/entries/:entryId",
  "method": "DELETE",
  "expectedStatus": 204,
  "priority": 157,
  "coversCriterion": [
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC1",
    "0fa1e67b-32d9-469e-b954-6ab5f0dd6ecd#AC3",
    "e39bf66f-0168-47cb-ad67-4413518095e9#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "entryId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Time entry not found",
      "when": "not one of the caller's entries"
    }
  ],
  "testCases": [
    {
      "name": "404 - someone else's entry",
      "headers": {
        "Authorization": "Bearer {{var:time_stopper_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "entryId": "{{var:time_spare_entry_id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "Consultant deletes an entry",
      "headers": {
        "Authorization": "Bearer {{var:time_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "pathParams": {
        "entryId": "{{var:time_spare_entry_id}}"
      },
      "expectedStatus": 204
    },
    {
      "name": "400 - not a uuid",
      "headers": {
        "Authorization": "Bearer {{var:time_token}}"
      },
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "entryId": "{{static:not-a-uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/42_time_log.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "entryId": "{{var:time_spare_entry_id}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
