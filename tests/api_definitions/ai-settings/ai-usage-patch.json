{
  "requiresAuth": true,
  "taskId": "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/settings/ai-usage/:projectId - set a project's AI estimates",
  "description": "Sets or clears (null) a project's AI cost estimate (USD) and token estimate; metering raises an alert the first time actual use reaches 2x either estimate. Covers: an alert fires at 2x the estimate.",
  "endpoint": "/api/settings/ai-usage/:projectId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 85,
  "coversCriterion": [
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC6"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices/:deviceId/projects"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Missing permission firm:manage",
      "when": "caller is a reviewer"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "costEstimateUsd must be positive",
      "when": "negative or empty body"
    }
  ],
  "testCases": [
    {
      "name": "Owner sets cost and token estimates",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "costEstimateUsd": 25,
        "tokenEstimate": 2000000
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "costEstimateUsd": 25,
          "tokenEstimate": 2000000
        }
      }
    },
    {
      "name": "400 - negative estimate",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "costEstimateUsd": -1
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "tokenEstimate": 5
      }
    },
    {
      "name": "403 - reviewer cannot manage AI settings",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "tokenEstimate": 5
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {
        "tokenEstimate": 5
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    }
  ]
}
