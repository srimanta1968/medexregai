  "name": "GET /api/projects/:projectId/inbound-email - the project's forwarding address",
  "description": "Projects:read. configured (the server has a receiving domain), the domain, and the active address with its allowed senders, or null when it is off. Covers: a per-project forwarding email address accepts attachments into the project within 2 minutes.",
  "endpoint": "/api/projects/:projectId/inbound-email",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 121,
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    }
  ],
  "testCases": [
    {
      "name": "Read the address",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "configured": true
        }
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    }
  ]
