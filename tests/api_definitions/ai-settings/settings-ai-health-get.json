{
  "name": "GET /api/settings/ai/health - live health of our models",
  "description": "For owners and admins (firm:manage): checks right now whether our self-hosted generation and embedding models are reachable and the configured models (default, per-route and embedding) are present; never spends generation tokens and is never cached. Always 200: an unreachable model shows as ok=false with a typed, retryable error (AI_UNAVAILABLE / AI_TIMEOUT), never as a server error. Covers: an admin can see the active model, provider and health; an unavailable model returns a clear retryable error.",
  "endpoint": "/api/settings/ai/health",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 80,
  "taskId": "4b123bec-212a-4937-afe3-43583ed8d9b4",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC3",
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC2",
    "4b123bec-212a-4937-afe3-43583ed8d9b4#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "responseFields": [
    "checkedAt",
    "platform"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Missing permission firm:manage",
      "when": "caller is a reviewer"
    }
  ],
  "testCases": [
    {
      "name": "Owner checks model health",
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    },
    {
      "name": "403 - reviewer cannot see AI settings",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      }
    }
  ]
}
