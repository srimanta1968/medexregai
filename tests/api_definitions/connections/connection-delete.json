{
  "name": "DELETE /api/connections/:connectionId - disconnect",
  "description": "Disconnects (AC3): revokes the grant at the provider where it allows that (Microsoft does not; the response says how to withdraw consent), erases both stored tokens and unlinks every folder that used the connection so sync stops. Files already imported stay. Returns 200 with revokedAtProvider, note and unlinkedFolders. The happy path needs a connection made through a real provider sign-in. Needs projects:write.",
  "endpoint": "/api/connections/:connectionId",
  "method": "DELETE",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 190,
  "taskId": "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "manual",
  "coversCriterion": [
    "717d5baf-5788-4106-9669-e387af1830b0#AC3",
    "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Connection not found",
      "when": "no such connection, or it belongs to another firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant disconnects",
      "pathParams": {
        "connectionId": "{{cache:connections.connected.response.data.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "connectionId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "403 - reviewer cannot disconnect",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "connectionId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "404 - unknown connection",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "connectionId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "connectionId": "{{static:not-a-uuid}}"
      }
    }
  ],
  "manualReason": "Needs a connection created by a real OAuth sign-in to Dropbox, Box, Microsoft or Google; no API or fixture can create one. Verify by hand: disconnect revokes the grant at the provider and unlinks its folders.",
  "skipReason": "Needs a connection created by a real OAuth sign-in to Dropbox, Box, Microsoft or Google; no API or fixture can create one. Verify by hand: disconnect revokes the grant at the provider and unlinks its folders."
}
