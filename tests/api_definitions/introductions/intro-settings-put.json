{
  "requiresAuth": true,
  "taskId": "944991b0-597f-4388-b6b4-b514ba034cb8",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PUT /api/introductions/settings - opt in or out of introductions",
  "description": "Opt the firm in or out and choose the FDA medical specialties (codes such as CV, HO, OP) and pathways (510k, de_novo, pma) it takes; empty lists mean any. Only opted-in firms are ever offered a request. Needs firm:manage; audited. Routing (F6.2 AC1): a company's request is offered only to firms that opted in and whose FDA medical specialties and pathways match (a firm listing none takes any); up to 3 firms, longest since their last offer first. Fixture 53_introductions.py proves it across three firms (opted in and matching, matching but not opted in, opted in but another specialty).",
  "endpoint": "/api/introductions/settings",
  "method": "PUT",
  "expectedStatus": 200,
  "priority": 232,
  "coversCriterion": [
    "a44bb850-46f5-44bd-920e-205427202979#AC1",
    "944991b0-597f-4388-b6b4-b514ba034cb8#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "payload": {
    "optedIn": false,
    "specialties": [
      "CV"
    ],
    "pathways": [
      "510k"
    ],
    "profile": "{{static:Cardio devices (fictional).}}"
  },
  "fieldEnums": {
    "specialties": [
      "AN",
      "CV",
      "CH",
      "TX",
      "DE",
      "EN",
      "GU",
      "SU",
      "HO",
      "HE",
      "IM",
      "MI",
      "NE",
      "OB",
      "OP",
      "OR",
      "PA",
      "PM",
      "RA"
    ],
    "pathways": [
      "510k",
      "de_novo",
      "pma"
    ]
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "specialty must be an FDA medical specialty code, e.g. CV or HO",
      "when": "optedIn missing, an unknown specialty or pathway, profile over 1000 characters, or an unknown field"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks firm:manage (editors, reviewers, viewers)",
      "reproducible": false,
      "notReproducibleReason": "Fixture firms have only an owner."
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Opt out with a profile",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "optedIn": false,
        "specialties": [
          "CV",
          "HO"
        ],
        "pathways": [
          "510k"
        ],
        "profile": "{{static:Cardio and hospital devices (fictional).}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "optedIn": false
        }
      }
    },
    {
      "name": "400 - unknown specialty",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "optedIn": true,
        "specialties": [
          "XX"
        ]
      }
    },
    {
      "name": "400 - unknown pathway",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "optedIn": true,
        "pathways": [
          "hde"
        ]
      }
    },
    {
      "name": "400 - optedIn missing",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "specialties": [
          "CV"
        ]
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "payload": {
        "optedIn": false
      }
    }
  ]
}
