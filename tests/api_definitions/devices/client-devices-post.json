{
  "name": "POST /api/clients/:clientId/devices - add a device to a client",
  "description": "Creates a device with a stable identity: name (unique per client), modelNames[], optional UDI-DI (6-23 chars, unique per firm), optional product code (3 letters, upper-cased) and class (I|II|III). Needs projects:write. Covers: a device has a stable identity with model names and a nullable UDI-DI.",
  "endpoint": "/api/clients/:clientId/devices",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "priority": 53,
  "taskId": "a9fee73a-bb05-4de6-b28d-10dd328567a9",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "aace117c-ee0f-45ab-8e35-83da03f3824f#AC2",
    "a9fee73a-bb05-4de6-b28d-10dd328567a9#AC1",
    "aace117c-ee0f-45ab-8e35-83da03f3824f#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "captureResponse": {
    "devices.create.response.data.id": "data.id",
    "devices.create.response.data.name": "data.name"
  },
  "fieldEnums": {
    "deviceClass": [
      "I",
      "II",
      "III"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Client not found",
      "when": "client does not exist or belongs to another firm (same answer, so other firms' ids are not disclosed)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "udiDi must be 6-23",
      "when": "udiDi, productCode or deviceClass malformed"
    },
    {
      "status": 409,
      "code": "DUPLICATE_NAME",
      "message": "already has a device with this name",
      "when": "same device name (any case) under this client"
    },
    {
      "status": 409,
      "code": "DUPLICATE_UDI_DI",
      "message": "already has this UDI-DI",
      "when": "UDI-DI already used by another device in the firm",
      "reproducible": false,
      "notReproducibleReason": "Needs a fixed UDI-DI shared by two devices in one run; covered on PATCH /api/devices/:deviceId by hand (409 verified)."
    }
  ],
  "testCases": [
    {
      "name": "Owner adds a device without a UDI-DI",
      "capturesResponse": true,
      "pathParams": {
        "clientId": "{{cache:clients.create.response.data.id}}"
      },
      "coversCriterion": [
        "aace117c-ee0f-45ab-8e35-83da03f3824f#AC3"
      ],
      "payload": {
        "name": "{{dynamic:productname}}",
        "modelNames": [
          "{{static:IP-100}}",
          "{{static:IP-200}}"
        ],
        "productCode": "{{static:FRN}}",
        "deviceClass": "II"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "udiDi": null,
          "deviceClass": "II"
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "clientId": "{{cache:clients.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "403 - reviewer cannot write",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "clientId": "{{cache:clients.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "404 - unknown client",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "clientId": "{{dynamic:uuid}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}"
      }
    },
    {
      "name": "400 - malformed UDI-DI",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "clientId": "{{cache:clients.create.response.data.id}}"
      },
      "payload": {
        "name": "{{dynamic:productname}}",
        "udiDi": "{{static:bad udi!}}"
      }
    },
    {
      "name": "409 - duplicate device name",
      "testType": "negative",
      "coversErrorCase": "409|DUPLICATE_NAME",
      "expectedStatus": 409,
      "expectedError": {
        "code": "DUPLICATE_NAME"
      },
      "pathParams": {
        "clientId": "{{cache:clients.create.response.data.id}}"
      },
      "payload": {
        "name": "{{cache:devices.create.response.data.name}}"
      }
    }
  ]
}
