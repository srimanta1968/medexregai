{
  "requiresAuth": true,
  "taskId": "734d0cc8-7d90-41e5-b5dd-88eb2409f31b",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/requests - the project's client requests",
  "description": "Projects:read. The project's requests, newest first, cursor-paginated (limit 1-50): title, status (draft, open, closed), recipient, item and received counts, email status. Covers: each requested item shows its status until received.",
  "endpoint": "/api/projects/:projectId/requests",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 102,
  "coversCriterion": [
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC6"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/requests"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "cursor is invalid",
      "when": "a malformed cursor or limit outside 1-50"
    }
  ],
  "testCases": [
    {
      "name": "Owner lists the project's requests",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "limit": "20"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - bad cursor",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "cursor": "{{static:not-a-cursor}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    }
  ]
}
