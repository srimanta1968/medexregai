{
  "requiresAuth": true,
  "taskId": "2dfbf561-a083-4c55-a824-35e5c9ab3ba7",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/requests/:requestId/link - issue a new upload link",
  "description": "Projects:write. For an open request: withdraws the current link and issues a new one (1-30 days, default 14), returned once. Audited (client_request.link_issued). Covers: a link can expire or be revoked (and be replaced).",
  "endpoint": "/api/requests/:requestId/link",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 108,
  "coversCriterion": [
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/requests",
    "POST /api/requests/:requestId/approve"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Request not found",
      "when": "no request with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "expiresInDays must be at most 30",
      "when": "expiresInDays outside 1-30"
    },
    {
      "status": 409,
      "code": "REQUEST_NOT_OPEN",
      "message": "Approve the request first; a link is issued when it is approved.",
      "when": "the request is still a draft"
    }
  ],
  "testCases": [
    {
      "name": "Owner issues a fresh 3-day link",
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {
        "expiresInDays": 3
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "request": {
            "status": "open"
          }
        }
      },
      "capturesResponse": true
    },
    {
      "name": "400 - link longer than 30 days",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {
        "expiresInDays": 90
      }
    },
    {
      "name": "409 - the request is still a draft",
      "testType": "negative",
      "coversErrorCase": "409|REQUEST_NOT_OPEN",
      "expectedStatus": 409,
      "expectedError": {
        "code": "REQUEST_NOT_OPEN"
      },
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id@draft}}"
      },
      "payload": {}
    },
    {
      "name": "404 - unknown request",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "requestId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {}
    }
  ],
  "captureResponse": {
    "requests.reissue.response.data.link.token": "data.link.token",
    "requests.reissue.response.data.request.id": "data.request.id"
  }
}
