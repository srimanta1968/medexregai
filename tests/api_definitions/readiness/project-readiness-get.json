{
  "requiresAuth": true,
  "taskId": "5c62975a-e8af-4989-8185-0fe13b7cef62",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/readiness - eSTAR attachment checks",
  "description": "Attachment checks flag names of 124 characters or more, files over 1 GB, totals over 4 GB and zip files (F3.4 AC1), per the project's eSTAR template (AC2), and report the running total against the 4 GB limit (AC4). Attachments are the project's files filed under evidence sections, in FDA section order. Each issue says whether it is FDA's stated rule or our interpretation. The fixture project has a 125-character name (error) and a zip (error). Needs projects:read.",
  "endpoint": "/api/projects/:projectId/readiness",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 114,
  "coversCriterion": [
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC1",
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC2",
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC4",
    "5c62975a-e8af-4989-8185-0fe13b7cef62#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    }
  ],
  "testCases": [
    {
      "name": "Consultant sees the long name and the zip flagged",
      "headers": {
        "Authorization": "Bearer {{var:readiness_token}}"
      },
      "fixture": "tests/setup_scripts/30_readiness.py",
      "pathParams": {
        "projectId": "{{var:readiness_project_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "ready": false,
          "counts": {
            "attachments": 3,
            "errors": 2
          }
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      }
    }
  ],
  "fieldEnums": {
    "severity": [
      "error",
      "warning"
    ],
    "basis": [
      "fda",
      "interpretation"
    ],
    "code": [
      "NAME_TOO_LONG",
      "NAME_AT_LIMIT",
      "FILE_TOO_LARGE",
      "ARCHIVE_REJECTED",
      "ARCHIVE_LIKELY_REJECTED",
      "SIZE_UNKNOWN",
      "TOTAL_TOO_LARGE"
    ]
  }
}
