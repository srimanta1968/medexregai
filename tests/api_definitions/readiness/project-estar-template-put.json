{
  "requiresAuth": true,
  "taskId": "5c62975a-e8af-4989-8185-0fe13b7cef62",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PUT /api/projects/:projectId/estar-template - choose the eSTAR template",
  "description": "Readiness checks are versioned per eSTAR template (F3.4 AC2): set the template the project is checked against; answers with the readiness under that template. Needs projects:write.",
  "endpoint": "/api/projects/:projectId/estar-template",
  "method": "PUT",
  "expectedStatus": 200,
  "priority": 115,
  "coversCriterion": [
    "0ad2942c-8e6a-42bb-ad18-257d9cb83890#AC2",
    "5c62975a-e8af-4989-8185-0fe13b7cef62#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project, or another firm’s"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "template must be one of",
      "when": "unknown template, or path id not a UUID"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow",
      "when": "role lacks projects:write (e.g. reviewer)"
    }
  ],
  "testCases": [
    {
      "name": "Consultant checks the project against the IVD template",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "template": "{{static:IVD-7.1}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "template": {
            "key": "IVD-7.1"
          }
        }
      }
    },
    {
      "name": "400 - unknown template",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "template": "{{static:nIVD-5.0}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "template": "{{static:IVD-7.1}}"
      }
    },
    {
      "name": "403 - reviewer role cannot change it",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "template": "{{static:IVD-7.1}}"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}"
      },
      "payload": {
        "template": "{{static:IVD-7.1}}"
      }
    }
  ],
  "fieldEnums": {
    "template": [
      "nIVD-7.1",
      "IVD-7.1"
    ]
  }
}
