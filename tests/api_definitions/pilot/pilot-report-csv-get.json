{
  "requiresAuth": true,
  "taskId": "ba95f351-522e-4fa9-8728-1a4c4d7b603f",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/pilot-report/csv - hours by activity as CSV",
  "description": "Hours by activity export to CSV and the report has a sign-off for the firm's RA lead (F4.2 AC3): one row per A3 activity (code, label, logged hours, baseline hours, % lower) then the drafted-sections and whole-project totals; text/csv with a UTF-8 byte order mark; cells never read as formulas; X-Report-SHA256 header. Needs projects:read; audited as pilot.report_exported.",
  "endpoint": "/api/projects/:projectId/pilot-report/csv",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 174,
  "coversCriterion": [
    "8810a366-70b1-4b42-a9ca-ab8411e7ce9c#AC3",
    "ba95f351-522e-4fa9-8728-1a4c4d7b603f#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "projectId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project in the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant exports hours by activity",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/43_pilot_report.py",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "expectedStatus": 200
    },
    {
      "name": "404 - another firm's project",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "400 - not a uuid",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/43_pilot_report.py",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "pathParams": {
        "projectId": "{{static:not-a-uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
