{
  "name": "medexregai",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "lint": "eslint src tests",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
    "db:checks": "ts-node --transpile-only src/db/scaleChecks.ts",
    "typecheck": "tsc --noEmit -p .",
    "eval": "ts-node --transpile-only src/ai/eval/cli.ts",
    "test:injection": "ts-node --transpile-only src/ai/guard/injectionSuite.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@medexregai/fda-sdk": "file:../packages/fda-sdk",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "jose": "5.9.6",
    "jsonwebtoken": "^9.0.2",
    "jszip": "3.10.1",
    "mailparser": "3.12.4",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "stripe": "23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "3.4.6",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.2"
  }
}
