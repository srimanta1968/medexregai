{
  "name": "POST /api/invites - invite someone to the firm with a role",
  "description": "A firm owner or admin (permission members:invite) invites a person by email with one of the roles admin, editor, reviewer or viewer. Emails a single-use link valid 7 days and returns the invite, the raw inviteToken and acceptUrl (so the inviter can also copy the link). Owner cannot be invited. Covers: a firm owner can invite a reviewer with a specific role by email.",
  "endpoint": "/api/invites",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "priority": 20,
  "taskId": "4db4f875-3b3c-4b9f-abea-3a4076f7b895",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC2",
    "4db4f875-3b3c-4b9f-abea-3a4076f7b895#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "captureResponse": {
    "invites.create.response.data.invite.id": "data.invite.id",
    "invites.create.response.data.invite.email": "data.invite.email",
    "invites.create.response.data.inviteToken": "data.inviteToken"
  },
  "fieldEnums": {
    "role": [
      "admin",
      "editor",
      "reviewer",
      "viewer"
    ]
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "INVALID_ROLE",
      "message": "role must be one of admin, editor, reviewer, viewer",
      "when": "role is owner or unknown"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "email must be a valid email address",
      "when": "email malformed"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "caller role lacks members:invite (editor, reviewer, viewer); proven on GET /api/invites with a reviewer token"
    },
    {
      "status": 409,
      "code": "INVITE_PENDING",
      "message": "An invitation to this email is already pending",
      "when": "an open invite already exists for this email in this firm"
    },
    {
      "status": 409,
      "code": "ALREADY_MEMBER",
      "message": "This person is already a member of your firm",
      "when": "email belongs to an active member"
    }
  ],
  "testCases": [
    {
      "name": "Owner invites a reviewer by email",
      "coversCriterion": [
        "ea7bf6cb-a1f4-450f-b884-9b7a5b3b9f58#AC2",
        "4db4f875-3b3c-4b9f-abea-3a4076f7b895#AC1"
      ],
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "email": "{{dynamic:email}}",
        "role": "reviewer"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "invite": {
            "role": "reviewer"
          }
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED",
        "messageContains": "Missing bearer token"
      },
      "payload": {
        "email": "{{dynamic:email}}",
        "role": "reviewer"
      },
      "headers": {}
    },
    {
      "name": "400 - owner role cannot be invited",
      "testType": "negative",
      "coversErrorCase": "400|INVALID_ROLE",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ROLE"
      },
      "payload": {
        "email": "{{dynamic:email}}",
        "role": "owner"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    },
    {
      "name": "400 - malformed email",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "payload": {
        "email": "{{static:not-an-email}}",
        "role": "reviewer"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    },
    {
      "name": "409 - invite already pending for this email",
      "testType": "negative",
      "coversErrorCase": "409|INVITE_PENDING",
      "expectedStatus": 409,
      "expectedError": {
        "code": "INVITE_PENDING"
      },
      "payload": {
        "email": "{{cache:invites.create.response.data.invite.email}}",
        "role": "viewer"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ]
}
