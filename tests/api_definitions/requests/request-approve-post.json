{
  "requiresAuth": true,
  "taskId": "b06d70a5-018f-4068-ac75-7f5fa3c75a54",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "captureResponse": {
    "requests.approve.response.data.request.id": "data.request.id",
    "requests.approve.response.data.link.token": "data.link.token"
  },
  "name": "POST /api/requests/:requestId/approve - approve a request and issue its upload link",
  "description": "Projects:write. Approves a draft (status open) and issues an expiring no-login upload link (1-30 days, default 14). The link (url and token) is returned only here; only its SHA-256 is stored. When the request has a recipient email the approved message is emailed with the link and delivery is recorded (emailStatus sent or failed; a failed email never undoes the approval). Audited (client_request.approved). Covers: nothing is sent until the consultant edits and approves it; a client can upload via an expiring link without logging in.",
  "endpoint": "/api/requests/:requestId/approve",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 105,
  "coversCriterion": [
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC5",
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC2",
    "b06d70a5-018f-4068-ac75-7f5fa3c75a54#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/requests"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Request not found",
      "when": "no request with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "expiresInDays must be at most 30",
      "when": "expiresInDays outside 1-30"
    },
    {
      "status": 409,
      "code": "REQUEST_NOT_DRAFT",
      "message": "This request has already been approved.",
      "when": "approving twice"
    }
  ],
  "testCases": [
    {
      "name": "Owner approves the draft; a 7-day link is issued and the message emailed",
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {
        "expiresInDays": 7
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "request": {
            "status": "open"
          }
        }
      },
      "capturesResponse": true
    },
    {
      "name": "409 - approved twice",
      "testType": "negative",
      "coversErrorCase": "409|REQUEST_NOT_DRAFT",
      "expectedStatus": 409,
      "expectedError": {
        "code": "REQUEST_NOT_DRAFT"
      },
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {}
    },
    {
      "name": "400 - link longer than 30 days",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {
        "expiresInDays": 90
      }
    },
    {
      "name": "404 - unknown request",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "requestId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {}
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id}}"
      },
      "payload": {}
    }
  ]
}
