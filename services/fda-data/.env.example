# =============================================================================
# fda-data service (ADR-017). Copy to .env. Separate from server/.env: this
# service has its own database and never sees customer data or app secrets.
# =============================================================================
PORT=4100

# Primary FDA database (writes). Its own instance in production; in local dev it
# can be a separate database on the dev Postgres, e.g. .../fda_db.
FDA_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/fda_db   # REQUIRED
# Or give the parts instead of a URL (production: from the RDS secret):
# FDA_DB_HOST= FDA_DB_PORT=5432 FDA_DB_USER= FDA_DB_PASSWORD= FDA_DB_NAME=fda_db
FDA_DB_SSL=false
# Optional read replica for /v1 reads (URL, or FDA_READ_DB_HOST with the same credentials); blank = primary.
FDA_READ_DATABASE_URL=
FDA_READ_DB_HOST=
FDA_DB_POOL_MAX=10

# openFDA (public). A free API key raises the daily request allowance.
OPENFDA_API_KEY=
# openFDA allows 240 requests per minute; stay below it.
OPENFDA_MAX_PER_MINUTE=200
OPENFDA_INITIAL_LOOKBACK_DAYS=90
# Product codes to track for MAUDE counts besides those the app pushes.
FDA_EVENT_PRODUCT_CODES=
FDA_SYNC_HOUR_UTC=3
