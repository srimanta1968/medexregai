{
  "requiresAuth": true,
  "taskId": "734d0cc8-7d90-41e5-b5dd-88eb2409f31b",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "captureResponse": {
    "requests.create.response.data.id": "data.id",
    "requests.create.response.data.items.0.id": "data.items.0.id"
  },
  "name": "POST /api/projects/:projectId/requests - draft a client request",
  "description": "Projects:write. Drafts a request for missing evidence: title, the message the client will read, an optional recipient (name, email) and 1-50 items (label, detail, the submission section the evidence is for). Saved as status draft: nothing reaches the client until it is approved. Audited (client_request.created). Covers: a consultant can create a client request (from open gaps once F2.3 lists them; items are entered by hand until then); nothing is sent until the consultant edits and approves it. (sectionId, the submission section an item's evidence is for, is a section key such as sterility_shelf_life, not a database id; it is left out of the test payload.)",
  "endpoint": "/api/projects/:projectId/requests",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 101,
  "coversCriterion": [
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC1",
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC5",
    "734d0cc8-7d90-41e5-b5dd-88eb2409f31b#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Add at least one item",
      "when": "items empty or missing, title missing, or a bad recipient email"
    }
  ],
  "testCases": [
    {
      "name": "Owner drafts a request with two items",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "title": "{{static:Missing evidence for the 510(k)}}",
        "message": "{{static:Please upload the documents below.}}",
        "recipientName": "{{static:Ana Client}}",
        "recipientEmail": "{{dynamic:email}}",
        "items": [
          {
            "label": "{{static:EO residuals report}}",
            "detail": "{{static:ISO 10993-7, final signed copy}}"
          },
          {
            "label": "{{static:Signed tensile test report}}"
          }
        ]
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "draft"
        }
      },
      "capturesResponse": true
    },
    {
      "name": "400 - no items",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "title": "{{static:Missing evidence}}",
        "items": []
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {
        "title": "{{static:Missing evidence for the 510(k)}}",
        "message": "{{static:Please upload the documents below.}}",
        "recipientName": "{{static:Ana Client}}",
        "recipientEmail": "{{dynamic:email}}",
        "items": [
          {
            "label": "{{static:EO residuals report}}",
            "detail": "{{static:ISO 10993-7, final signed copy}}"
          },
          {
            "label": "{{static:Signed tensile test report}}"
          }
        ]
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "payload": {
        "title": "{{static:Missing evidence for the 510(k)}}",
        "message": "{{static:Please upload the documents below.}}",
        "recipientName": "{{static:Ana Client}}",
        "recipientEmail": "{{dynamic:email}}",
        "items": [
          {
            "label": "{{static:EO residuals report}}",
            "detail": "{{static:ISO 10993-7, final signed copy}}"
          },
          {
            "label": "{{static:Signed tensile test report}}"
          }
        ]
      }
    }
  ]
}
