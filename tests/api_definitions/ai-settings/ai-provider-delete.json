{
  "requiresAuth": true,
  "taskId": "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "DELETE /api/settings/ai-providers/:providerId - remove a firm provider",
  "description": "Removes a firm provider and its stored key; its routes fall back to our platform models at once. 204 with no body.",
  "endpoint": "/api/settings/ai-providers/:providerId",
  "method": "DELETE",
  "expectedStatus": 204,
  "priority": 89,
  "coversCriterion": [
    "4c39a3ec-c61a-4e2b-8b39-2fd1c101a93a#AC5",
    "a64d6c55-1858-4ba2-9e3d-d1ac6de8df92#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/settings/ai-providers",
    "PATCH /api/settings/ai-providers/:providerId",
    "POST /api/settings/ai-providers/:providerId/test"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Missing permission firm:manage",
      "when": "caller is a reviewer"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "AI provider not found",
      "when": "no provider with this id in the firm"
    }
  ],
  "testCases": [
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      }
    },
    {
      "name": "403 - reviewer cannot manage AI settings",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      }
    },
    {
      "name": "Owner deletes the provider",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "expectedStatus": 204
    },
    {
      "name": "404 - already deleted",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "providerId": "{{cache:aiProviders.create.response.data.id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    }
  ]
}
