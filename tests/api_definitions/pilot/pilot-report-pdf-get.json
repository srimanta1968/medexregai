{
  "requiresAuth": true,
  "taskId": "470069e8-c4ad-47de-8e91-1610ad6bb2a5",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/pilot-report/pdf - the pilot report as PDF",
  "description": "The pilot report exports as PDF (F4.2 AC2): the same numbers as GET pilot-report (hours against the baseline, drafted sections, acceptance, hours by activity, sign-offs, the proposed targets labelled as such) with the report SHA-256 in the document and the X-Report-SHA256 header. Needs projects:read; audited as pilot.report_exported.",
  "endpoint": "/api/projects/:projectId/pilot-report/pdf",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 173,
  "coversCriterion": [
    "8810a366-70b1-4b42-a9ca-ab8411e7ce9c#AC2",
    "470069e8-c4ad-47de-8e91-1610ad6bb2a5#AC2"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "projectId must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no such project in the caller's firm"
    }
  ],
  "testCases": [
    {
      "name": "Consultant downloads the pilot report",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/43_pilot_report.py",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "expectedStatus": 200
    },
    {
      "name": "404 - another firm's project",
      "headers": {
        "Authorization": "Bearer {{var:pilot_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "pathParams": {
        "projectId": "{{var:style_project_id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "pathParams": {
        "projectId": "{{var:pilot_project_id}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
}
