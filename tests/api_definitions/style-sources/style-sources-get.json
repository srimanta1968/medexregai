  "name": "GET /api/style-sources - whether the firm's style sources are on",
  "description": "Drafts can follow the firm's own templates and past wording, used only for that firm (F3.6 AC1); turning firm style sources off removes them from drafting within 1 hour and past wording never crosses tenants (F3.6 AC5). Style sources (the firm's section templates and past wording) are opt-in: off until the firm turns them on. Returns { enabled, updatedAt, updatedByName }. Needs projects:read.",
  "endpoint": "/api/style-sources",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 130,
  "coversCriterion": [
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC1",
    "80537ab9-7bf2-419f-b19d-0e8f8e76968b#AC5",
    "b3fcbe8e-822c-4e8a-9efd-507e81697eec#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Firm with style sources on",
      "headers": {
        "Authorization": "Bearer {{var:style_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "enabled": true
        }
      }
    },
    {
      "name": "Firm that turned them off again",
      "headers": {
        "Authorization": "Bearer {{var:other_token}}"
      },
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "enabled": false
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "headers": {},
      "fixture": "tests/setup_scripts/41_firm_style.py",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      }
    }
  ]
