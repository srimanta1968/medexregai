{
  "openapi": "3.1.0",
  "info": {
    "title": "MedexRegAI fda-data API",
    "version": "1.0.0",
    "description": "Public FDA device data (openFDA 510(k), classification, recall, GUDID, MAUDE counts) held in its own database. Service-to-service only: send X-Api-Key. Responses carry a weak ETag; send If-None-Match to get 304."
  },
  "servers": [
    {
      "url": "http://localhost:4100"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "summary": "Data freshness per dataset",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed parameter (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked API key (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the fda:read scope (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Client rate limit exceeded (RATE_LIMITED); see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/510k/{kNumber}": {
      "get": {
