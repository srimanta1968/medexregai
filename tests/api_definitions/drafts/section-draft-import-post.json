{
  "requiresAuth": true,
  "taskId": "91e7f58c-a5fa-49b6-a2f4-fc8bb115e36d",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "POST /api/project-sections/:sectionId/draft/import - import the edited Word copy",
  "description": "An edited DOCX can be re-imported and human edits are kept as human-approved (F3.2 AC4). Body { fileName, contentBase64 } of an export of this section. Creates a new draft version (origin imported, based on the exported one): untouched statements keep their citations; edited statements become human_edited and text written outside any statement becomes human_added, both human-approved by the importer; deleted statements are listed in importSummary. 415 for a file that is not a .docx, 400 for a DOCX not exported from this section. Needs projects:write.",
  "endpoint": "/api/project-sections/:sectionId/draft/import",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 109,
  "coversCriterion": [
    "4bb0c6e6-956d-41c0-a6ee-01496b331169#AC4",
    "91e7f58c-a5fa-49b6-a2f4-fc8bb115e36d#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "GET /api/projects/:projectId/sections"
  ],
  "captureResponse": {
    "drafts.import.response.data.id": "data.id"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (e.g. reviewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "was not exported from this section",
      "when": "the DOCX is not an export of this section, or fileName/contentBase64 missing or not base64"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Section not found",
      "when": "no such section, or another firm’s"
    },
    {
      "status": 413,
      "code": "FILE_TOO_LARGE",
      "message": "can be imported",
      "when": "the document is over 5 MB (the 1 MB JSON body limit usually refuses it first)"
    },
    {
      "status": 415,
      "code": "UNSUPPORTED_FILE_TYPE",
      "message": "Word document",
      "when": "the file is not a .docx"
    }
  ],
  "testCases": [
    {
      "name": "Consultant imports the edited draft",
      "headers": {
        "Authorization": "Bearer {{var:draft_token}}"
      },
      "fixture": "tests/setup_scripts/20_section_draft.py",
      "pathParams": {
        "sectionId": "{{var:draft_section_id}}"
      },
      "payload": {
        "fileName": "{{static:Sterility draft v1 edited.docx}}",
        "contentBase64": "{{var:draft_import_base64}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "origin": "imported"
        }
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "fileName": "{{static:x.docx}}",
        "contentBase64": "{{static:UEsDBA==}}"
      }
    },
    {
      "name": "415 - not a Word document",
      "testType": "negative",
      "coversErrorCase": "415|UNSUPPORTED_FILE_TYPE",
      "expectedStatus": 415,
      "expectedError": {
        "code": "UNSUPPORTED_FILE_TYPE"
      },
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "fileName": "{{static:draft.pdf}}",
        "contentBase64": "{{static:JVBERi0=}}"
      }
    },
    {
      "name": "400 - a Word file that was not exported from this section",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:draft_token}}"
      },
      "fixture": "tests/setup_scripts/20_section_draft.py",
      "pathParams": {
        "sectionId": "{{var:draft_other_section_id}}"
      },
      "payload": {
        "fileName": "{{static:Sterility draft v1 edited.docx}}",
        "contentBase64": "{{var:draft_import_base64}}"
      }
    },
    {
      "name": "400 - contentBase64 is not base64",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "fileName": "{{static:x.docx}}",
        "contentBase64": "{{static:not base64!}}"
      }
    },
    {
      "name": "403 - reviewer role cannot import",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "sectionId": "{{cache:sections.board.response.data.sections.0.id}}"
      },
      "payload": {
        "fileName": "{{static:x.docx}}",
        "contentBase64": "{{static:UEsDBA==}}"
      }
    },
    {
      "name": "404 - unknown section",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "sectionId": "{{dynamic:uuid}}"
      },
      "payload": {
        "fileName": "{{static:x.docx}}",
        "contentBase64": "{{static:UEsDBA==}}"
      }
    }
  ],
  "fieldEnums": {
    "origin": [
      "generated",
      "imported"
    ]
  }
}
