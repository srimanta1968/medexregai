{
  "name": "DELETE /api/projects/:projectId/folder-links/:linkId - stop syncing a folder",
  "description": "Unlinks a folder (AC3): the sync job stops following it; files already imported stay in the project. Returns 200 with the link (status unlinked). The happy path needs a folder linked through a real provider connection. Needs projects:write. The happy path needs a folder link made through a real provider sign-in (no fixture can create one): set connected_folder_link_id in tests/config/test-config.json to such a link to run it; without it the case is skipped rather than run on a stale id.",
  "endpoint": "/api/projects/:projectId/folder-links/:linkId",
  "method": "DELETE",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 191,
  "taskId": "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "coversCriterion": [
    "717d5baf-5788-4106-9669-e387af1830b0#AC3",
    "d3ab69bc-9f38-45e4-ae74-b9a5a447ddbf#AC3"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/folder-links"
  ],
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "does not allow this action",
      "when": "role lacks projects:write (reviewer, viewer)"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "must be a valid id",
      "when": "path id is not a UUID"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Folder link not found",
      "when": "no such active link on this project"
    }
  ],
  "testCases": [
    {
      "name": "Consultant stops syncing a folder",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}",
        "linkId": "{{var:connected_folder_link_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}",
        "linkId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "403 - reviewer cannot unlink",
      "testType": "negative",
      "coversErrorCase": "403|FORBIDDEN",
      "expectedStatus": 403,
      "expectedError": {
        "code": "FORBIDDEN"
      },
      "headers": {
        "Authorization": "Bearer {{var:reviewer_token}}"
      },
      "fixture": "tests/setup_scripts/10_auth_actors.py",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}",
        "linkId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "404 - unknown link (or project)",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{dynamic:uuid}}",
        "linkId": "{{dynamic:uuid}}"
      }
    },
    {
      "name": "400 - not a uuid",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}",
        "linkId": "{{static:not-a-uuid}}"
      }
    }
  ]
}
