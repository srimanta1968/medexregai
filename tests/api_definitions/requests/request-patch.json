{
  "requiresAuth": true,
  "taskId": "734d0cc8-7d90-41e5-b5dd-88eb2409f31b",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "PATCH /api/requests/:requestId - edit a draft request",
  "description": "Projects:write. Edits a draft's title, message, recipient or items (items are replaced). Once approved the text the client received is not changed: 409 REQUEST_NOT_DRAFT. Audited (client_request.updated). Covers: the consultant edits the request before anything is sent.",
  "endpoint": "/api/requests/:requestId",
  "method": "PATCH",
  "expectedStatus": 200,
  "priority": 104,
  "coversCriterion": [
    "9f681fa2-274c-4df2-a91f-d57dee368de1#AC5"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/clients",
    "POST /api/clients/:clientId/devices",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/requests"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Request not found",
      "when": "no request with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "Nothing to update",
      "when": "an empty body or an invalid field"
    },
    {
      "status": 409,
      "code": "REQUEST_NOT_DRAFT",
      "message": "Only a draft request can be edited; this one has been approved.",
      "when": "the request was already approved"
    }
  ],
  "testCases": [
    {
      "name": "Owner edits the draft message",
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id@editable}}"
      },
      "payload": {
        "message": "{{static:Please upload the two documents below.}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "status": "draft"
        }
      }
    },
    {
      "name": "400 - nothing to update",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id@editable}}"
      },
      "payload": {}
    },
    {
      "name": "409 - request already approved",
      "testType": "negative",
      "coversErrorCase": "409|REQUEST_NOT_DRAFT",
      "expectedStatus": 409,
      "expectedError": {
        "code": "REQUEST_NOT_DRAFT"
      },
      "pathParams": {
        "requestId": "{{cache:requests.approve.response.data.request.id}}"
      },
      "payload": {
        "message": "{{static:changed}}"
      },
      "dependsOn": [
        "POST /api/requests/:requestId/approve"
      ],
      "notes": "Runs after the approve definition (priority 105)."
    },
    {
      "name": "404 - unknown request",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "requestId": "{{static:00000000-0000-4000-8000-000000000000}}"
      },
      "payload": {
        "message": "{{static:x}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "requestId": "{{cache:requests.create.response.data.id@editable}}"
      },
      "payload": {
        "message": "{{static:x}}"
      }
    }
  ],
  "notes": "Edits its own @editable request. Every POST (approve included) runs before PATCH definitions, and the Dev MCP can approve a labelled request by mistake (an on-demand labelled producer whose own @label input is unresolved falls back to the last captured request), so this test does not share a record with any other definition."
}
