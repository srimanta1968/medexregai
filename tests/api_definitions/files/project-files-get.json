{
  "requiresAuth": true,
  "taskId": "2fd4277b-fd52-48f0-970f-3dc09c43653e",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/files - project files with ingest status",
  "description": "A project's files, newest first (cursor pagination, limit 1-50), each with its latest version: number, parse status and error, parser, page/sheet/slide count, PHI status and finding count, and whether our copy is kept (linked copies are discarded after processing). Covers: files are parsed with page, sheet, cell or slide locations; re-uploading creates a new version.",
  "endpoint": "/api/projects/:projectId/files",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 91,
  "coversCriterion": [
    "25aed8eb-2a0c-411e-947c-1963ebf27356#AC1",
    "25aed8eb-2a0c-411e-947c-1963ebf27356#AC2",
    "2fd4277b-fd52-48f0-970f-3dc09c43653e#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices/:deviceId/projects",
    "POST /api/projects/:projectId/files"
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    },
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "no project with this id in the firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "cursor is invalid",
      "when": "malformed cursor or limit out of range"
    }
  ],
  "testCases": [
    {
      "name": "Owner lists the project files",
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "limit": "20"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "400 - invalid cursor",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      },
      "queryParams": {
        "cursor": "nonsense"
      }
    },
    {
      "name": "404 - unknown project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "headers": {},
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "pathParams": {
        "projectId": "{{cache:projects.create.response.data.id}}"
      }
    }
  ]
}
