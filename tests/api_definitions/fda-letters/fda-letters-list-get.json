{
  "requiresAuth": true,
  "taskId": "37cb380d-5c35-4456-96a5-eb8650b72bfc",
  "sprintId": "aed7ad96-9852-4c09-8cd7-d557960c2c58",
  "testability": "auto",
  "headers": {
    "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
  },
  "name": "GET /api/projects/:projectId/fda-letters - a project's FDA letters",
  "description": "An FDA AI or hold letter can be logged with deficiencies linked to sections and due dates (F5.1 AC1). The project's Additional Information requests and RTA hold letters, newest first: kind, FDA reference, issued, received and due dates, status, deficiency and answered counts, and daysLeft (calendar days to the due date while open; FDA allows 180 calendar days from the date of the request, with no extensions). Needs projects:read.",
  "endpoint": "/api/projects/:projectId/fda-letters",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 190,
  "coversCriterion": [
    "af7a916c-8bab-433f-9dab-3ae83f278b73#AC1",
    "37cb380d-5c35-4456-96a5-eb8650b72bfc#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "errorCases": [
    {
      "status": 404,
      "code": "NOT_FOUND",
      "message": "Project not found",
      "when": "project is not in the caller's firm"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "projectId must be a valid id",
      "when": "a field is missing, malformed or out of range, or a link is to another project"
    },
    {
      "status": 403,
      "code": "FORBIDDEN",
      "message": "Insufficient permissions",
      "when": "caller lacks projects:read"
    },
    {
      "status": 401,
      "code": "UNAUTHORIZED",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ],
  "testCases": [
    {
      "name": "Lists both letters of the project",
      "fixture": "tests/setup_scripts/46_fda_letters.py",
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "pathParams": {
        "projectId": "{{var:fl_project_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    },
    {
      "name": "404 - another firm's project",
      "testType": "negative",
      "coversErrorCase": "404|NOT_FOUND",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "projectId": "{{var:fl_project_id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "400 - projectId is not an id",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      },
      "headers": {
        "Authorization": "Bearer {{var:fl_token}}"
      },
      "pathParams": {
        "projectId": "{{static:not-an-id}}"
      },
      "fixture": "tests/setup_scripts/46_fda_letters.py"
    },
    {
      "name": "401 - missing bearer token",
      "testType": "negative",
      "coversErrorCase": "401|UNAUTHORIZED",
      "expectedStatus": 401,
      "expectedError": {
        "code": "UNAUTHORIZED"
      },
      "headers": {},
      "pathParams": {
        "projectId": "{{static:00000000-0000-4000-8000-000000000000}}"
      }
    }
  ],
  "pathParams": {
    "projectId": "{{var:fl_project_id}}"
  }
}
